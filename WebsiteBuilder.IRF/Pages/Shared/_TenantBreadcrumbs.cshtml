@using WebsiteBuilder.IRF.Infrastructure.Tenancy
@inject ITenantNavigationService NavService
@inject ITenantContext TenantContext

@functions {
    private static string NormalizePath(string? path)
    {
        var p = (path ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(p))
            return "/";

        // Strip query/hash if present
        var q = p.IndexOfAny(new[] { '?', '#' });
        if (q >= 0) p = p.Substring(0, q);

        // Only normalize app-relative paths; do not touch absolute URLs
        if (!p.StartsWith("/", StringComparison.Ordinal))
            return p;

        // Normalize trailing slash (except root)
        p = p.TrimEnd('/');
        if (p.Length == 0) p = "/";

        // Treat /home as /
        if (p.Equals("/home", StringComparison.OrdinalIgnoreCase))
            p = "/";

        return p;
    }

    private static bool IsAbsoluteUrl(string? url)
        => !string.IsNullOrWhiteSpace(url) &&
           (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase));

    private static bool IsAppRelativeUrl(string? url)
        => !string.IsNullOrWhiteSpace(url) &&
           url.StartsWith("/", StringComparison.Ordinal) &&
           !IsAbsoluteUrl(url);

    private static bool IsMeaningfulCrumbUrl(string? url)
        => !string.IsNullOrWhiteSpace(url) &&
           !url.Equals("#", StringComparison.Ordinal) &&
           IsAppRelativeUrl(url);

    // Section-aware match: exact or prefix (/about/team activates /about)
    private static bool MatchCurrentOrSection(string currentPath, string itemUrl)
    {
        if (!IsAppRelativeUrl(itemUrl)) return false;

        var cur = NormalizePath(currentPath);
        var url = NormalizePath(itemUrl);

        if (url == "/") return cur == "/";
        if (string.Equals(cur, url, StringComparison.OrdinalIgnoreCase)) return true;

        return cur.StartsWith(url + "/", StringComparison.OrdinalIgnoreCase);
    }

    // Find the BEST trail = deepest match (longest matching URL)
    private static void FindBestTrail(
        IReadOnlyList<NavItem> items,
        string currentPath,
        List<NavItem> working,
        ref List<NavItem>? best,
        ref int bestScore)
    {
        foreach (var item in items)
        {
            working.Add(item);

            // Score by normalized URL length (deeper wins)
            if (MatchCurrentOrSection(currentPath, item.Url))
            {
                var score = NormalizePath(item.Url).Length;
                if (score > bestScore)
                {
                    bestScore = score;
                    best = new List<NavItem>(working);
                }
            }

            if (item.Children != null && item.Children.Count > 0)
            {
                FindBestTrail(item.Children, currentPath, working, ref best, ref bestScore);
            }

            working.RemoveAt(working.Count - 1);
        }
    }
}

@if (TenantContext.IsResolved)
{
    var currentPath = NormalizePath(Context?.Request?.Path.Value ?? "/");

    // Hide breadcrumbs on home/root
    if (currentPath != "/")
    {
        var headerItems = await NavService.GetHeaderAsync();

        List<NavItem>? bestTrail = null;
        var bestScore = -1;

        FindBestTrail(headerItems, currentPath, new List<NavItem>(), ref bestTrail, ref bestScore);

        // Only render when we found a matching nav path
        if (bestTrail != null && bestTrail.Count > 0)
        {
            // If trail begins with a "Home" entry (Url "/" or "/home"), remove it to prevent "Home > Home".
            var firstUrl = NormalizePath(bestTrail[0].Url);
            if (firstUrl == "/")
                bestTrail.RemoveAt(0);

            if (bestTrail.Count > 0)
            {
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/" class="text-decoration-none">Home</a>
                        </li>

                        @for (int i = 0; i < bestTrail.Count; i++)
                        {
                            var item = bestTrail[i];
                            var isLast = (i == bestTrail.Count - 1);

                            if (isLast)
                            {
                                <li class="breadcrumb-item active" aria-current="page">@item.Title</li>
                            }
                            else
                            {
                                if (IsMeaningfulCrumbUrl(item.Url))
                                {
                                    <li class="breadcrumb-item">
                                        <a class="text-decoration-none" href="@item.Url">@item.Title</a>
                                    </li>
                                }
                                else
                                {
                                    <li class="breadcrumb-item">@item.Title</li>
                                }
                            }
                        }
                    </ol>
                </nav>
            }
        }
    }
}
