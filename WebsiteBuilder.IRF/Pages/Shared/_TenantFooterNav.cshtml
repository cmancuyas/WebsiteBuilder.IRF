@using WebsiteBuilder.IRF.Infrastructure.Tenancy
@inject ITenantNavigationService Nav

@{
    var items = await Nav.GetFooterAsync();

    static bool IsDisabledUrl(string? url)
        => string.IsNullOrWhiteSpace(url) || url.Trim() == "#";

    // Footer: keep it clean—don't render dead links at all
    var visible = items.Where(x => !IsDisabledUrl(x.Url)).ToList();
}

@if (visible.Count > 0)
{
    <ul class="list-inline mb-0">
        @foreach (var n in visible)
        {
            <li class="list-inline-item me-3">
                <a class="text-muted text-decoration-none"
                   href="@n.Url"
                   @(n.OpenInNewTab ? "target=\"_blank\" rel=\"noopener\"" : null)>
                    @n.Title
                </a>
            </li>
        }
    </ul>
}
