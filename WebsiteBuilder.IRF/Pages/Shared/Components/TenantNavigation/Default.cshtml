@using WebsiteBuilder.IRF.Infrastructure.Tenancy
@model WebsiteBuilder.IRF.Infrastructure.Tenancy.TenantNavigationVm

@{
    var idx = 0;
    var variant = (Model.Variant ?? "header").ToLowerInvariant();

    static string SafeHref(string url)
        => string.IsNullOrWhiteSpace(url) ? "#" : url;

    // -----------------------------
    // Active detection (merged)
    // -----------------------------
    string NormalizePath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "/";

        var p = path.Trim();

        // strip query if present (defensive)
        var q = p.IndexOf('?', StringComparison.Ordinal);
        if (q >= 0) p = p[..q];

        // ensure leading slash for internal
        if (!p.StartsWith("/", StringComparison.Ordinal)) p = "/" + p;

        // normalize trailing slash (except root)
        if (p.Length > 1 && p.EndsWith("/", StringComparison.Ordinal))
            p = p.TrimEnd('/');

        return p.ToLowerInvariant();
    }

    bool IsExternal(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        return url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
    }

    bool IsActiveUrl(string currentPath, string itemUrl)
    {
        var cur = NormalizePath(currentPath);
        var url = NormalizePath(itemUrl);

        if (url == "/") return cur == "/";
        if (cur == url) return true;

        // section match
        return cur.StartsWith(url + "/", StringComparison.Ordinal);
    }

    // Compute IsActive / IsAncestorOfActive on the VM nodes for this request
    void ComputeActiveFlags(TenantNavigationVm.Node node, string currentPath)
    {
        // reset (important if VM is reused/cached)
        node.IsActive = false;
        node.IsAncestorOfActive = false;

        if (!string.IsNullOrWhiteSpace(node.Url) && !IsExternal(node.Url))
        {
            node.IsActive = IsActiveUrl(currentPath, node.Url);
        }

        foreach (var child in node.Children)
        {
            ComputeActiveFlags(child, currentPath);
        }

        // ancestor flag if any descendant active (or ancestor of active)
        if (node.Children.Count > 0)
        {
            node.IsAncestorOfActive = node.Children.Any(c => c.IsActive || c.IsAncestorOfActive);
        }
    }

    var current = NormalizePath(Context?.Request?.Path.Value ?? "/");
    foreach (var root in Model.Items)
    {
        ComputeActiveFlags(root, current);
    }

    // =========================
    // FOOTER RENDERER (recursive)
    // =========================
    void RenderFooterNode(TenantNavigationVm.Node node)
    {
        var isActive = node.IsActive || node.IsAncestorOfActive;

        <li class="mb-1">
            <a class="text-decoration-none @(isActive ? "fw-semibold" : "")"
               href="@SafeHref(node.Url)"
               target="@(node.OpenInNewTab ? "_blank" : null)"
               rel="@(node.OpenInNewTab ? "noopener noreferrer" : null)">
                @node.Title
            </a>

            @if (node.Children.Count > 0)
            {
                <ul class="list-unstyled ms-3 mt-1">
                    @foreach (var child in node.Children)
                    {
                        RenderFooterNode(child);
                    }
                </ul>
            }
        </li>
    }

    // ====================================
    // HEADER DROPDOWN ITEMS (safe, flat)
    // ====================================
    void RenderHeaderDropdownItems(IReadOnlyList<TenantNavigationVm.Node> children)
    {
        foreach (var child in children)
        {
            if (child.Children.Count > 0)
            {
                <li>
                    <h6 class="dropdown-header @(child.IsActive || child.IsAncestorOfActive ? "text-primary" : "")">
                        @child.Title
                    </h6>
                </li>

                foreach (var gc in child.Children)
                {
                    <li>
                        <a class="dropdown-item @(gc.IsActive ? "active" : "")"
                           href="@SafeHref(gc.Url)"
                           target="@(gc.OpenInNewTab ? "_blank" : null)"
                           rel="@(gc.OpenInNewTab ? "noopener noreferrer" : null)"
                           @(gc.IsActive ? "aria-current=\"page\"" : null)>
                            — @gc.Title
                        </a>
                    </li>
                }

                <li><hr class="dropdown-divider" /></li>
            }
            else
            {
                <li>
                    <a class="dropdown-item @(child.IsActive ? "active" : "")"
                       href="@SafeHref(child.Url)"
                       target="@(child.OpenInNewTab ? "_blank" : null)"
                       rel="@(child.OpenInNewTab ? "noopener noreferrer" : null)"
                       @(child.IsActive ? "aria-current=\"page\"" : null)>
                        @child.Title
                    </a>
                </li>
            }
        }
    }
}

@* ======================
   FOOTER NAVIGATION
   ====================== *@
@if (variant == "footer")
{
    <nav aria-label="Footer navigation">
        <ul class="list-unstyled mb-0">
            @foreach (var item in Model.Items)
            {
                RenderFooterNode(item);
            }
        </ul>
    </nav>
}
else
{
    @* ======================
   HEADER NAVIGATION
   ====================== *@
    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        @foreach (var item in Model.Items)
        {
            var hasChildren = item.Children.Count > 0;
            var isActive = item.IsActive || item.IsAncestorOfActive;

            if (!hasChildren)
            {
                <li class="nav-item">
                    <a class="nav-link text-dark @(isActive ? "active" : "")"
                       href="@SafeHref(item.Url)"
                       target="@(item.OpenInNewTab ? "_blank" : null)"
                       rel="@(item.OpenInNewTab ? "noopener noreferrer" : null)"
                       @(item.IsActive ? "aria-current=\"page\"" : null)>
                        @item.Title
                    </a>
                </li>
            }
            else
            {
                var ddId = $"tenant-nav-dd-{idx++}";
                var menuShow = isActive ? "show" : ""; // optional: keep dropdown open if child active

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-dark @(isActive ? "active" : "")"
                       href="#"
                       id="@ddId"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        @item.Title
                    </a>

                    <ul class="dropdown-menu @menuShow" aria-labelledby="@ddId">
                        @{
                            RenderHeaderDropdownItems(item.Children);
                        }
                    </ul>
                </li>
            }
        }
    </ul>
}
