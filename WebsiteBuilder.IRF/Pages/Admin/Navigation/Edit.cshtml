@page
@using System.Text.Json
@using WebsiteBuilder.Models.Constants
@model WebsiteBuilder.IRF.Pages.Admin.Navigation.EditModel

@{
    ViewData["Title"] = "Edit Navigation";
}

<form id="antiForgeryForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">Edit Navigation</h2>
        <div class="text-muted small">MenuId: @Model.MenuId</div>
    </div>

    <div class="d-flex gap-2">
        <a asp-page="/Admin/Navigation/Index" class="btn btn-outline-secondary">Back</a>
        <button id="addRootBtn" type="button" class="btn btn-outline-primary">Add Item</button>
        <button type="button" id="undoBtn" class="btn btn-outline-secondary btn-sm" disabled>Undo</button>
        <button type="button" id="redoBtn" class="btn btn-outline-secondary btn-sm" disabled>Redo</button>

        <button id="saveBtn" type="button" class="btn btn-primary">Save Changes</button>
        <button id="toggleDeletedBtn" type="button" class="btn btn-outline-danger">
            Show deleted
        </button>

        <button id="saveViewBtn" type="button" class="btn btn-outline-success">Save &amp; View Site</button>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div>
                    <strong>Menu Structure</strong>
                    <div class="text-muted small">Drag to reorder. Drag into an item to nest.</div>
                </div>
                <span class="badge text-bg-secondary">Tenant-scoped</span>
            </div>

            <div class="card-body">
                <div id="statusMsg" class="alert alert-info d-none"></div>

                <ul id="navRoot" class="nav-tree list-unstyled mb-0">
                    @foreach (var node in Model.Tree)
                    {
                        @Html.Partial("_NavNode", node)
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><strong>Linking</strong></div>
            <div class="card-body">
                <p class="text-muted mb-2">Each menu item can link to either:</p>
                <ul class="text-muted mb-0">
                    <li>Internal page (PageId)</li>
                    <li>External URL (Url)</li>
                </ul>
                <hr />
                <div class="small text-muted">
                    Rule: If a Page is selected, Url is disabled and cleared. If you type a Url, Page is cleared.
                </div>
            </div>
        </div>
    </div>
</div>

<div id="navToast"
     class="position-fixed bottom-0 end-0 m-3 px-3 py-2 rounded shadow-sm d-none"
     style="background:#222;color:#fff;z-index:1050;font-size:0.875rem;max-width:360px;">
</div>


@section Scripts {
    <script src="~/lib/jquery-sortablejs/jquery-sortable.min.js"></script>
    <script src="~/lib/sortable/sortable.min.js"></script>

    <script>
        (() => {
            'use strict';

            // -----------------------------
            // State
            // -----------------------------
            let isDirty = false;
            let isSaving = false;          // UI state
            let saveInFlight = false;      // network state
            let saveQueued = false;

            let lastSavedAt = null;

            const menuId = @Model.MenuId;
            const sortableGroupName = 'nav-menu-' + menuId;

            const publicBaseUrl = @Html.Raw(JsonSerializer.Serialize(Model.PublicBaseUrl, new JsonSerializerOptions(JsonSerializerDefaults.Web)));
            const toastEl = document.getElementById('navToast');
            const navRoot = document.getElementById('navRoot');

            const showDeletedKey = `nav-show-deleted-${menuId}`;

            // ✅ server-provided numeric ID (do not hardcode)
            const PAGE_STATUS_PUBLISHED = Number(@PageStatusIds.Published);

            // pages/options
            let pages = @Html.Raw(Model.PagesJson);

            // flags (mutated on refresh)
            const pageFlagsById = @Html.Raw(Model.PageFlagsJson ?? "{}");

            // periodic refresh snapshots
            let lastFlagsSnapshot = {}; // { [id]: "show|status|active|deleted" }
            let lastPagesSnapshot = {}; // { [id]: "title|slug" }
            let lastRefreshToastAt = 0;

            // danger ack (persisted)
            const ackDangerByPageId = new Map(); // pageId -> lastSig
            const ackStorageKey = `nav-ack-danger-${menuId}`;

            const REFRESH_MS = 45000;

            // -----------------------------
            // Small utilities
            // -----------------------------
            function debounce(fn, ms) {
                let t = null;
                return function (...args) {
                    clearTimeout(t);
                    t = setTimeout(() => fn.apply(this, args), ms);
                };
            }

            function showToast(text, state) {
                if (!toastEl) return;

                toastEl.textContent = text;
                toastEl.classList.remove('d-none', 'bg-success', 'bg-danger', 'bg-secondary', 'bg-info');

                if (state === 'ok') toastEl.classList.add('bg-success');
                else if (state === 'error') toastEl.classList.add('bg-danger');
                else if (state === 'info') toastEl.classList.add('bg-info');
                else toastEl.classList.add('bg-secondary');

                setTimeout(() => toastEl.classList.add('d-none'), 1400);
            }

            function showMsg(text, kind) {
                const box = document.getElementById('statusMsg');
                if (!box) return;

                box.classList.remove('d-none', 'alert-info', 'alert-success', 'alert-danger');
                box.classList.add(kind === 'success' ? 'alert-success' : kind === 'error' ? 'alert-danger' : 'alert-info');
                box.textContent = text;
            }

            function getToken() {
                const el = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
                return el ? el.value : null;
            }

            function setDirty(on = true) {
                isDirty = !!on;
                if (isDirty) lastSavedAt = null;
                updateSaveButtonUi();
            }

            function updateSaveButtonUi() {
                const btn = document.getElementById('saveBtn');
                if (!btn) return;

                btn.disabled = !isDirty || isSaving;
                btn.classList.toggle('btn-warning', isDirty && !isSaving);
                btn.classList.toggle('btn-primary', !isDirty && !isSaving);

                if (isSaving) { btn.textContent = 'Saving…'; return; }
                if (!isDirty && lastSavedAt) { btn.textContent = 'Saved ✓'; return; }

                btn.textContent = isDirty ? 'Save Changes*' : 'Save Changes';
            }

            function escapeHtml(s) {
                return String(s)
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function normalizeUrlInput(u) { return (u || '').trim(); }

            function isValidUrlForNav(u) {
                if (!u) return false;
                return u.startsWith('/') || u.startsWith('http://') || u.startsWith('https://');
            }

            // -----------------------------
            // Deleted toggle
            // -----------------------------
            function getShowDeletedPref() {
                return localStorage.getItem(showDeletedKey) === 'true';
            }

            function setShowDeletedPref(val) {
                localStorage.setItem(showDeletedKey, val ? 'true' : 'false');
            }

            function applyShowDeletedUi() {
                const showDeleted = getShowDeletedPref();

                navRoot?.querySelectorAll('.nav-node').forEach(li => {
                    const isDel = li.dataset.deleted === 'true';
                    li.classList.toggle('deleted-hidden', isDel && !showDeleted);
                });

                const btn = document.getElementById('toggleDeletedBtn');
                if (btn) {
                    if (showDeleted) {
                        btn.textContent = 'Hide deleted';
                        btn.classList.remove('btn-outline-danger');
                        btn.classList.add('btn-danger');
                    } else {
                        btn.textContent = 'Show deleted';
                        btn.classList.remove('btn-danger');
                        btn.classList.add('btn-outline-danger');
                    }
                }

                refreshAllToggles();
                refreshAllBadges();
                refreshSortBadges();
            }

            // -----------------------------
            // Collapse logic
            // -----------------------------
            function collapseKeyFor(li) { return `nav-collapse-${menuId}-${li.dataset.id}`; }

            function hasChildren(li) {
                const ul = li.querySelector(':scope > .nav-children');
                if (!ul) return false;

                return Array.from(ul.children).some(x =>
                    x.classList &&
                    x.classList.contains('nav-node') &&
                    x.dataset.deleted !== 'true'
                );
            }

            function applyCollapseState(li) {
                const ul = li.querySelector(':scope > .nav-children');
                const btn = li.querySelector(':scope .toggle-children');
                if (!ul || !btn) return;

                const any = hasChildren(li);
                btn.classList.toggle('d-none', !any);

                const collapsed = localStorage.getItem(collapseKeyFor(li)) === 'true';

                if (any && collapsed) {
                    ul.classList.add('d-none');
                    btn.textContent = '▶';
                } else {
                    ul.classList.remove('d-none');
                    btn.textContent = any ? '▼' : '▼';
                }
            }

            function refreshAllToggles() {
                navRoot?.querySelectorAll('.nav-node').forEach(applyCollapseState);
            }

            // -----------------------------
            // Visibility badge + warn badge
            // -----------------------------
            function normalizeRolesCsv(s) {
                return (s || '')
                    .split(',')
                    .map(x => x.trim())
                    .filter(Boolean)
                    .join(',');
            }

            function computeVisibilityStatus(li) {
                const isDeleted = li?.dataset?.deleted === 'true';
                if (isDeleted) return { text: 'Deleted', cls: 'bg-danger', title: 'Marked for deletion' };

                const isActive = !!li.querySelector('.node-active')?.checked;
                const isPublished = !!li.querySelector('.node-published')?.checked;
                const rolesRaw = li.querySelector('.node-roles')?.value || '';
                const roles = normalizeRolesCsv(rolesRaw);

                if (!isActive) return { text: 'Inactive', cls: 'bg-secondary', title: 'Hidden (Inactive)' };
                if (!isPublished) return { text: 'Draft', cls: 'bg-warning text-dark', title: 'Not published (won’t show on tenant site)' };
                if (roles.length > 0) return { text: 'Restricted', cls: 'bg-info text-dark', title: `Visible only to roles: ${roles}` };

                return { text: 'Live', cls: 'bg-success', title: 'Visible to everyone on tenant site' };
            }

            function updateVisibilityBadge(li) {
                const badge = li.querySelector('.node-visibility-badge');
                if (!badge) return;

                const s = computeVisibilityStatus(li);
                badge.className = 'badge node-visibility-badge ' + s.cls;
                badge.textContent = s.text;
                badge.title = s.title;
            }

            function getSelectedPageId(li) {
                const linkType = (li.querySelector('.node-linktype')?.value || 'page').toLowerCase();
                if (linkType !== 'page') return null;

                const raw = li.querySelector('.node-pageid')?.value || '';
                const id = raw ? Number(raw) : null;
                return (id && id > 0) ? id : null;
            }

            function getFlagsSigForPage(pageId) {
                const key = String(pageId);
                return (lastFlagsSnapshot && lastFlagsSnapshot[key]) ? lastFlagsSnapshot[key] : null;
            }

            function isDangerAcked(pageId) {
                if (!(pageId > 0)) return false;
                const sig = getFlagsSigForPage(pageId);
                if (!sig) return false;
                return ackDangerByPageId.get(Number(pageId)) === sig;
            }

            function setDangerAck(pageId, on) {
                if (!(pageId > 0)) return;
                const sig = getFlagsSigForPage(pageId);
                if (!sig) return;

                if (on) ackDangerByPageId.set(Number(pageId), sig);
                else ackDangerByPageId.delete(Number(pageId));
            }

            function loadAckFromStorage() {
                try {
                    const raw = localStorage.getItem(ackStorageKey);
                    if (!raw) return;

                    const obj = JSON.parse(raw);
                    if (!obj || typeof obj !== 'object') return;

                    ackDangerByPageId.clear();
                    for (const [pidStr, sig] of Object.entries(obj)) {
                        const pid = Number(pidStr);
                        if (!(pid > 0) || typeof sig !== 'string') continue;
                        ackDangerByPageId.set(pid, sig);
                    }
                } catch { /* ignore */ }
            }

            function saveAckToStorage() {
                try {
                    const obj = {};
                    for (const [pid, sig] of ackDangerByPageId.entries()) {
                        obj[String(pid)] = sig;
                    }
                    localStorage.setItem(ackStorageKey, JSON.stringify(obj));
                } catch { /* ignore */ }
            }

            function updatePageWarnBadge(li) {
                const badge = li.querySelector('.node-page-warn-badge');
                if (!badge) return;

                const linkType = (li.querySelector('.node-linktype')?.value || 'page').toLowerCase();
                const pageId = getSelectedPageId(li);

                if (linkType !== 'page' || !pageId) {
                    badge.classList.add('d-none');
                    badge.textContent = '';
                    badge.title = '';
                    return;
                }

                const flags = pageFlagsById[String(pageId)] || pageFlagsById[pageId];
                if (!flags) {
                    badge.classList.add('d-none');
                    badge.textContent = '';
                    badge.title = '';
                    return;
                }

                const problems = [];
                if (flags.isDeleted) problems.push('Page is deleted');
                if (flags.isActive === false) problems.push('Page is inactive');
                if (typeof flags.pageStatusId === 'number' && flags.pageStatusId !== PAGE_STATUS_PUBLISHED) problems.push('Page is not published');
                if (flags.showInNavigation === false) problems.push('Page.ShowInNavigation is false');

                if (problems.length === 0) {
                    badge.classList.add('d-none');
                    badge.textContent = '';
                    badge.title = '';
                    return;
                }

                const hard = problems.some(p =>
                    p.includes('deleted') || p.includes('inactive') || p.includes('not published')
                );

                badge.classList.remove('d-none');
                badge.textContent = '⚠';
                badge.title = problems.join('\n');

                if (hard) {
                    const acked = isDangerAcked(pageId);
                    badge.style.opacity = acked ? '0.6' : '1';
                    badge.title += acked
                        ? '\n\nClick ⚠ to re-enable alerts for this page'
                        : '\n\nClick ⚠ to mute alerts for this page';
                } else {
                    badge.style.opacity = '1';
                }

                badge.classList.remove('bg-warning', 'bg-danger', 'text-dark', 'text-white');
                if (hard) badge.classList.add('bg-danger', 'text-white');
                else badge.classList.add('bg-warning', 'text-dark');
            }

            function refreshAllBadges() {
                navRoot?.querySelectorAll('.nav-node').forEach(li => {
                    updateVisibilityBadge(li);
                    updatePageWarnBadge(li);
                });
            }

            function wireBadgeAckToggle() {
                if (!navRoot) return;

                navRoot.addEventListener('click', (e) => {
                    const badge = e.target?.closest?.('.node-page-warn-badge');
                    if (!badge) return;

                    const li = badge.closest('.nav-node');
                    if (!li) return;

                    const pageId = getSelectedPageId(li);
                    if (!pageId) return;

                    const flags = pageFlagsById[String(pageId)] || pageFlagsById[pageId];
                    if (!flags) return;

                    const hard = !!flags.isDeleted
                        || flags.isActive === false
                        || (typeof flags.pageStatusId === 'number' && flags.pageStatusId !== PAGE_STATUS_PUBLISHED);

                    if (!hard) return;

                    const currentlyAcked = isDangerAcked(pageId);
                    setDangerAck(pageId, !currentlyAcked);
                    saveAckToStorage();

                    updatePageWarnBadge(li);
                    showToast(currentlyAcked ? 'Alerts re-enabled for this page' : 'Alerts muted for this page', 'info');
                });
            }

            // -----------------------------
            // Sort badges
            // -----------------------------
            function refreshSortBadges(rootUl = navRoot) {
                if (!rootUl) return;

                function updateUl(ul) {
                    const nodes = Array.from(ul.children)
                        .filter(x => x.classList && x.classList.contains('nav-node'));

                    let n = 0;

                    nodes.forEach(li => {
                        const badge = li.querySelector(':scope .sort-badge');
                        if (!badge) return;

                        const isDel = li.dataset.deleted === 'true';

                        if (isDel) {
                            badge.textContent = 'Del';
                            badge.classList.remove('bg-secondary');
                            badge.classList.add('bg-danger');
                            badge.title = 'Marked for deletion';
                            return;
                        }

                        n += 1;
                        badge.textContent = `S${n}`;
                        badge.classList.remove('bg-danger');
                        badge.classList.add('bg-secondary');
                        badge.title = `Sort order: ${n}`;
                    });

                    nodes.forEach(li => {
                        const childUl = li.querySelector(':scope > .nav-children');
                        if (childUl) updateUl(childUl);
                    });
                }

                updateUl(rootUl);
            }

            // -----------------------------
            // LinkType rules (AUTHORITATIVE: linkType drives fields)
            // -----------------------------
            function setLinkType(li, type) {
                const linkType = li.querySelector('.node-linktype');
                const pageWrap = li.querySelector('.node-pagewrap');
                const urlWrap = li.querySelector('.node-urlwrap');

                const pageSelect = li.querySelector('.node-pageid');
                const urlInput = li.querySelector('.node-url');

                if (linkType) linkType.value = type;

                if (type === 'page') {
                    pageWrap?.classList.remove('d-none');
                    urlWrap?.classList.add('d-none');

                    if (urlInput) {
                        urlInput.value = '';
                        urlInput.disabled = true;
                    }
                    if (pageSelect) pageSelect.disabled = false;
                } else {
                    urlWrap?.classList.remove('d-none');
                    pageWrap?.classList.add('d-none');

                    if (pageSelect) {
                        pageSelect.value = '';
                        pageSelect.disabled = true;
                    }
                    if (urlInput) urlInput.disabled = false;
                }
            }

            // ✅ LinkType is the authority; never infer type from URL value.
            function normalizeLinkInputs(li) {
                const type = (li.querySelector('.node-linktype')?.value || 'page').toLowerCase();

                const pageSelect = li.querySelector('.node-pageid');
                const urlInput = li.querySelector('.node-url');

                if (type === 'page') {
                    if (urlInput) urlInput.value = '';
                    setLinkType(li, 'page');
                    return;
                }

                if (type === 'url') {
                    if (pageSelect) pageSelect.value = '';
                    setLinkType(li, 'url');
                    return;
                }

                setLinkType(li, 'page');
            }

            // -----------------------------
            // Page option rendering
            // -----------------------------
            function renderPageOptions(selectedId) {
                const sel = selectedId ? String(selectedId) : '';

                return (pages || []).map(p => {
                    const id = p.id ?? p.Id;
                    const title = p.title ?? p.Title ?? '';
                    const slug = p.slug ?? p.Slug ?? '';
                    if (!id) return '';

                    const selected = sel && sel === String(id) ? 'selected' : '';
                    return `<option value="${id}" ${selected}>${escapeHtml(title)} (${escapeHtml(slug)})</option>`;
                }).join('');
            }

            // -----------------------------
            // Sortable
            // -----------------------------
            function initSortable(ul) {
                if (!ul) return;
                if (!window.Sortable) {
                    showMsg('SortableJS is not loaded. Ensure SortableJS is available as window.Sortable.', 'error');
                    return;
                }

                // ✅ prevent duplicates: destroy old instance if present
                if (ul._sortable) {
                    try { ul._sortable.destroy(); } catch { /* ignore */ }
                    ul._sortable = null;
                }

                ul._sortable = Sortable.create(ul, {
                    group: { name: sortableGroupName, pull: true, put: true },
                    animation: 150,
                    handle: '.drag-handle',
                    draggable: '.nav-node',
                    fallbackOnBody: true,
                    swapThreshold: 0.65,
                    onEnd: function () {
                        if (historyApplying) return;

                        setDirty(true);
                        pushHistory('drag');

                        refreshAllToggles();
                        refreshAllBadges();
                        refreshSortBadges();

                        showToast('Saving…', 'info');
                        autoSaveDebounced();
                    }
                });
            }


            function initAllSortables() {
                initSortable(navRoot);
                document.querySelectorAll('.nav-children').forEach(initSortable);
            }

            // -----------------------------
            // Build payload (normalized)
            // -----------------------------
            function buildFlatList(rootUl) {
                const items = [];

                function walk(ul, parentId) {
                    const children = Array.from(ul.children).filter(x => x.classList.contains('nav-node'));

                    children.forEach((li, idx) => {
                        const id = Number(li.dataset.id);
                        const deleted = li.dataset.deleted === 'true';

                        const label = li.querySelector('.node-label')?.value?.trim() || '';
                        const linkType = (li.querySelector('.node-linktype')?.value || 'page').toLowerCase();

                        const pageIdRaw = li.querySelector('.node-pageid')?.value || '';
                        const pageId = pageIdRaw ? Number(pageIdRaw) : null;

                        const urlRaw = li.querySelector('.node-url')?.value || '';
                        const url = normalizeUrlInput(urlRaw);

                        const openInNewTab = !!li.querySelector('.node-newtab')?.checked;
                        const isActive = !!li.querySelector('.node-active')?.checked;
                        const isPublished = !!li.querySelector('.node-published')?.checked;

                        const rolesCsv = li.querySelector('.node-roles')?.value?.trim() || '';
                        const allowedRolesCsv = rolesCsv.length ? normalizeRolesCsv(rolesCsv) : null;

                        const payloadItem = {
                            id,
                            parentId: parentId,
                            sortOrder: idx + 1,
                            label,
                            linkType,
                            pageId: null,
                            url: null,
                            allowedRolesCsv,
                            openInNewTab,
                            isActive,
                            isPublished,
                            isDeleted: deleted
                        };

                        if (linkType === 'page') {
                            payloadItem.pageId = (pageId && pageId > 0) ? pageId : null;
                            payloadItem.url = null;
                        } else if (linkType === 'url') {
                            payloadItem.pageId = null;
                            payloadItem.url = url ? url : null;
                        } else {
                            payloadItem.linkType = 'page';
                            payloadItem.pageId = (pageId && pageId > 0) ? pageId : null;
                            payloadItem.url = null;
                        }

                        items.push(payloadItem);

                        const childUl = li.querySelector(':scope > .nav-children');
                        if (childUl) walk(childUl, id);
                    });
                }

                walk(rootUl, null);
                return items;
            }

            // -----------------------------
            // Validation
            // -----------------------------
            function getPageFlags(pageId) {
                if (!pageId || pageId <= 0) return null;
                return pageFlagsById[String(pageId)] || pageFlagsById[pageId] || null;
            }

            function validatePayload(items) {
                const errors = [];

                items.forEach((x, i) => {
                    const row = i + 1;
                    if (x.isDeleted === true) return;

                    const label = (x.label || '').trim();
                    if (!label) {
                        errors.push({ index: i, message: `Row ${row}: Label is required.` });
                        return;
                    }

                    const linkType = (x.linkType || 'page').toLowerCase();
                    const pageId = Number(x.pageId || 0);
                    const url = normalizeUrlInput(x.url);

                    if (linkType === 'page') {
                        if (!(pageId > 0)) {
                            errors.push({ index: i, message: `Row ${row} (“${label}”): Please select an internal page.` });
                            return;
                        }

                        const flags = getPageFlags(pageId);
                        if (!flags) {
                            errors.push({ index: i, message: `Row ${row} (“${label}”): Selected page is unavailable. Choose another page or use External URL.` });
                            return;
                        }

                        if (flags.isDeleted) {
                            errors.push({ index: i, message: `Row ${row} (“${label}”): Selected page is deleted. Choose another page or use External URL.` });
                            return;
                        }

                        if (flags.isActive === false) {
                            errors.push({ index: i, message: `Row ${row} (“${label}”): Selected page is inactive. Choose another page or use External URL.` });
                            return;
                        }

                        if (typeof flags.pageStatusId === 'number' && flags.pageStatusId !== PAGE_STATUS_PUBLISHED) {
                            errors.push({ index: i, message: `Row ${row} (“${label}”): Selected page is not published. Choose another page or use External URL.` });
                            return;
                        }

                        return;
                    }

                    if (linkType === 'url') {
                        if (!url) {
                            errors.push({ index: i, message: `Row ${row} (“${label}”): URL is required when Link Type is External URL.` });
                            return;
                        }
                        if (!isValidUrlForNav(url)) {
                            errors.push({ index: i, message: `Row ${row} (“${label}”): URL must start with “/” or “http(s)://”.` });
                            return;
                        }
                        return;
                    }

                    errors.push({ index: i, message: `Row ${row} (“${label}”): Invalid Link Type.` });
                });

                return errors;
            }

            function expandNodeAndAncestors(li) {
                let cur = li;
                while (cur) {
                    const childUl = cur.querySelector(':scope > .nav-children');
                    const toggleBtn = cur.querySelector(':scope .toggle-children');

                    if (childUl && childUl.classList.contains('d-none')) {
                        childUl.classList.remove('d-none');
                        if (toggleBtn) toggleBtn.textContent = '▼';
                        localStorage.setItem(collapseKeyFor(cur), 'false');
                    }

                    const parentUl = cur.closest('ul');
                    const parentLi = parentUl?.closest('li.nav-node') || null;
                    cur = parentLi;
                }
            }

            function scrollToNode(li) {
                li.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            function focusFirstErrorField(li, payloadItem) {
                const linkType = (payloadItem.linkType || 'page').toLowerCase();

                if (linkType === 'page') {
                    const sel = li.querySelector('.node-pageid');
                    if (sel && !sel.disabled) {
                        sel.focus({ preventScroll: true });
                        sel.classList.add('is-invalid');
                        setTimeout(() => sel.classList.remove('is-invalid'), 1500);
                        return;
                    }
                }

                if (linkType === 'url') {
                    const inp = li.querySelector('.node-url');
                    if (inp && !inp.disabled) {
                        inp.focus({ preventScroll: true });
                        inp.classList.add('is-invalid');
                        setTimeout(() => inp.classList.remove('is-invalid'), 1500);
                        return;
                    }
                }

                const label = li.querySelector('.node-label');
                if (label) {
                    label.focus({ preventScroll: true });
                    label.classList.add('is-invalid');
                    setTimeout(() => label.classList.remove('is-invalid'), 1500);
                }
            }

            // ✅ locate error node by payload item id (not NodeList index)
            function showValidationErrors(errors, payloadItems) {
                if (!errors || errors.length === 0) return;

                alert("Please fix the following before saving:\n\n" + errors.map(e => `• ${e.message}`).join('\n'));

                const first = errors[0];
                const item = payloadItems?.[first.index];
                if (!item) return;

                const li = navRoot?.querySelector(`.nav-node[data-id="${item.id}"]`);
                if (!li) return;

                expandNodeAndAncestors(li);
                scrollToNode(li);
                focusFirstErrorField(li, item);
            }

            // -----------------------------
            // Save
            // -----------------------------
            const autoSaveDebounced = debounce(() => {
                if (!isDirty || isSaving) return;
                save().catch(err => {
                    showToast(err.message || 'Save failed', 'error');
                    showMsg(err.message || 'Save failed', 'error');
                });
            }, 700);

            async function save() {
                if (!isDirty) { updateSaveButtonUi(); return true; }
                if (isSaving) return false;
                if (saveInFlight) { saveQueued = true; return false; }

                isSaving = true;
                updateSaveButtonUi();

                try {
                    const token = getToken();
                    if (!token) {
                        showToast('Missing antiforgery token.', 'error');
                        showMsg('Missing antiforgery token.', 'error');
                        return false;
                    }

                    if (!navRoot) return false;

                    const payload = { menuId, items: buildFlatList(navRoot) };

                    const errors = validatePayload(payload.items);
                    if (errors.length) {
                        showValidationErrors(errors, payload.items);
                        showToast('Validation failed.', 'error');
                        showMsg('Validation failed. Please fix the highlighted item and try again.', 'error');
                        return false;
                    }

                    saveInFlight = true;
                    showToast('Saving…', 'info');

                    let res, data;
                    try {
                        res = await fetch('?handler=Save', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify(payload)
                        });

                        data = await res.json().catch(() => null);
                    } finally {
                        saveInFlight = false;
                    }

                    if (!res.ok || !data || !data.success) {
                        const err = data?.error ?? `Save failed (HTTP ${res.status})`;
                        showToast(err, 'error');
                        showMsg(err, 'error');
                        return false;
                    }

                    // remap temp ids to real ids
                    if (data.idMap) {
                        for (const [tempIdStr, realId] of Object.entries(data.idMap)) {
                            const li = navRoot.querySelector(`.nav-node[data-id="${tempIdStr}"]`);
                            if (!li) continue;

                            const oldKey = `nav-collapse-${menuId}-${tempIdStr}`;
                            const newKey = `nav-collapse-${menuId}-${realId}`;

                            const oldState = localStorage.getItem(oldKey);
                            if (oldState !== null && localStorage.getItem(newKey) === null) {
                                localStorage.setItem(newKey, oldState);
                            }
                            localStorage.removeItem(oldKey);

                            li.dataset.id = String(realId);
                        }
                    }

                    showToast('Saved', 'ok');
                    showMsg('Saved successfully.', 'success');

                    setDirty(false);
                    lastSavedAt = new Date();
                    updateSaveButtonUi();

                    refreshAllToggles();
                    refreshAllBadges();
                    refreshSortBadges();

                    await refreshPageFlagsFromServer();
                    await refreshPageOptionsFromServer();

                    if (saveQueued) {
                        saveQueued = false;
                        autoSaveDebounced();
                    }

                    // Baseline snapshot after a successful save (so undo doesn't jump before server id remap)
                    pushHistory('post-save');

                    return true;
                } catch (err) {
                    const msg = err?.message || 'Unexpected error';
                    showToast(msg, 'error');
                    showMsg(msg, 'error');
                    return false;
                } finally {
                    isSaving = false;
                    updateSaveButtonUi();
                }
            }

            // -----------------------------
            // Undo / Redo (DOM snapshot)
            // -----------------------------
            const HISTORY_LIMIT = 50;
            let undoStack = [];
            let redoStack = [];
            let historyApplying = false;

            function updateUndoRedoUi() {
                const u = document.getElementById('undoBtn');
                const r = document.getElementById('redoBtn');
                if (u) u.disabled = undoStack.length <= 1 || isSaving || saveInFlight;
                if (r) r.disabled = redoStack.length === 0 || isSaving || saveInFlight;
            }

            function captureSnapshot() {
                if (!navRoot) return null;

                function readUl(ul) {
                    const children = Array.from(ul.children).filter(x => x.classList.contains('nav-node'));
                    return children.map(li => {
                        const id = String(li.dataset.id || '');
                        return {
                            id,
                            deleted: li.dataset.deleted === 'true',
                            label: li.querySelector('.node-label')?.value ?? '',
                            linkType: li.querySelector('.node-linktype')?.value ?? 'page',
                            pageId: li.querySelector('.node-pageid')?.value ?? '',
                            url: li.querySelector('.node-url')?.value ?? '',
                            openInNewTab: !!li.querySelector('.node-newtab')?.checked,
                            isActive: !!li.querySelector('.node-active')?.checked,
                            isPublished: !!li.querySelector('.node-published')?.checked,
                            rolesCsv: li.querySelector('.node-roles')?.value ?? '',
                            children: (() => {
                                const childUl = li.querySelector(':scope > .nav-children');
                                return childUl ? readUl(childUl) : [];
                            })()
                        };
                    });
                }

                return {
                    v: 1,
                    menuId,
                    showDeleted: getShowDeletedPref(),
                    tree: readUl(navRoot)
                };
            }

            function pushHistory(reason = '') {
                if (historyApplying) return;
                const snap = captureSnapshot();
                if (!snap) return;

                const snapJson = JSON.stringify(snap);
                const last = undoStack.length ? undoStack[undoStack.length - 1].json : null;

                if (last === snapJson) return;

                undoStack.push({ json: snapJson, reason, at: Date.now() });

                if (undoStack.length > HISTORY_LIMIT) {
                    // keep baseline at index 0
                    undoStack.splice(1, undoStack.length - HISTORY_LIMIT);
                }

                redoStack = [];
                updateUndoRedoUi();
            }

            // -----------------------------
            // Node factory (createNodeLi)
            // -----------------------------
            let nextTempId = -1;

            function createNodeLi(forcedId) {
                const id = (typeof forcedId !== 'undefined' && forcedId !== null)
                    ? String(forcedId)
                    : String(nextTempId--);

                const li = document.createElement('li');
                li.className = 'nav-node mb-2';
                li.dataset.id = id;
                li.dataset.deleted = 'false';

                // Use the same child UL class set you have in _NavNode.cshtml
                const childUlHtml = `<ul class="nav-children list-unstyled ms-4 mt-2 mb-0"></ul>`;

                li.innerHTML = `
            <div class="node-row border rounded p-2 bg-white">
              <div class="d-flex align-items-start gap-2">

                <div class="drag-handle text-muted" title="Drag to reorder" style="cursor: grab; user-select: none;">
                  &#x2630;
                </div>

                <button type="button"
                        class="btn btn-sm btn-link toggle-children px-1 d-none"
                        aria-label="Toggle children"
                        style="text-decoration:none;">
                  ▼
                </button>

                <span class="badge bg-secondary sort-badge">S?</span>

                <span class="badge bg-warning text-dark d-none node-page-warn-badge" title=""></span>

                <div class="flex-grow-1">
                  <div class="row g-2">
                    <div class="col-12">
                      <span class="badge bg-secondary node-visibility-badge" title="Visibility status">…</span>
                    </div>

                    <div class="col-12">
                      <label class="form-label mb-1 small">Label</label>
                      <input class="form-control form-control-sm node-label" value="" maxlength="200" />
                    </div>

                    <div class="col-12">
                      <label class="form-label mb-1 small">Link Type</label>
                      <select class="form-select form-select-sm node-linktype">
                        <option value="page" selected>Internal Page</option>
                        <option value="url">External URL</option>
                      </select>
                    </div>

                    <div class="col-12 node-pagewrap">
                      <label class="form-label mb-1 small">Page</label>
                      <select class="form-select form-select-sm node-pageid">
                        <option value="">-- Select page --</option>
                        ${renderPageOptions('')}
                      </select>
                    </div>

                    <div class="col-12 node-urlwrap d-none">
                      <label class="form-label mb-1 small">URL</label>
                      <input class="form-control form-control-sm node-url"
                             value=""
                             maxlength="500"
                             placeholder="https://..." disabled />
                    </div>

                    <div class="col-12 d-flex flex-wrap gap-3 align-items-center">
                      <div class="form-check form-switch">
                        <input class="form-check-input node-newtab" type="checkbox" />
                        <label class="form-check-label small">Open in new tab</label>
                      </div>

                      <div class="form-check form-switch">
                        <input class="form-check-input node-active" type="checkbox" checked />
                        <label class="form-check-label small">Active</label>
                      </div>

                      <div class="form-check form-switch">
                        <input class="form-check-input node-published" type="checkbox" checked />
                        <label class="form-check-label small">Published</label>
                      </div>
                    </div>

                    <div class="col-12">
                      <label class="form-label mb-1 small">Visible to Roles (CSV)</label>
                      <input class="form-control form-control-sm node-roles"
                             value=""
                             maxlength="400"
                             placeholder="e.g. Admin,Agent (leave blank for everyone)" />
                    </div>

                  </div>
                </div>

                <div class="d-flex flex-column gap-2">
                  <button type="button" class="btn btn-sm btn-outline-secondary add-child">Add Child</button>

                  <button type="button" class="btn btn-sm btn-outline-danger delete-node">Delete</button>
                  <button type="button" class="btn btn-sm btn-outline-success restore-node d-none">Restore</button>
                </div>

              </div>
            </div>

            ${childUlHtml}
            `.trim();

                // IMPORTANT: new node has no handlers until wired
                // We intentionally do NOT call wireNodeUi here so caller controls timing,
                // but it's safe to do it here too if you prefer.
                wireNodeUi(li);

                // Ensure its children UL becomes sortable
                const childUl = li.querySelector(':scope > .nav-children');
                if (childUl) initSortable(childUl);

                // Initial derived UI
                normalizeLinkInputs(li);
                applyCollapseState(li);
                updateVisibilityBadge(li);
                updatePageWarnBadge(li);

                return li;
            }




            function applySnapshot(snapshotJson) {
                if (!navRoot) return;

                const snap = JSON.parse(snapshotJson);
                if (!snap || snap.v !== 1) return;

                historyApplying = true;
                try {
                    // restore preference first
                    setShowDeletedPref(!!snap.showDeleted);

                    // cache existing nodes so we can reuse DOM elements
                    const existingById = new Map();
                    navRoot.querySelectorAll('.nav-node').forEach(li => {
                        const id = String(li.dataset.id || '');
                        if (id) existingById.set(id, li);
                    });

                    // track which ones we had to create so we can wire them
                    const newlyCreated = [];

                    function ensureChildrenUl(li) {
                        let ul = li.querySelector(':scope > .nav-children');
                        if (!ul) {
                            ul = document.createElement('ul');
                            ul.className = 'nav-children list-unstyled ms-4 mt-2 mb-0';
                            li.appendChild(ul);
                        }
                        return ul;
                    }

                    function setFields(li, node) {
                        // IMPORTANT: keep the snapshot id (can be temp id like "-1")
                        li.dataset.id = String(node.id ?? '');
                        li.dataset.deleted = node.deleted ? 'true' : 'false';

                        const label = li.querySelector('.node-label'); if (label) label.value = node.label ?? '';
                        const lt = li.querySelector('.node-linktype'); if (lt) lt.value = node.linkType ?? 'page';

                        const pageSel = li.querySelector('.node-pageid'); if (pageSel) pageSel.value = node.pageId ?? '';
                        const urlInp = li.querySelector('.node-url'); if (urlInp) urlInp.value = node.url ?? '';

                        const nt = li.querySelector('.node-newtab'); if (nt) nt.checked = !!node.openInNewTab;
                        const ia = li.querySelector('.node-active'); if (ia) ia.checked = !!node.isActive;
                        const ip = li.querySelector('.node-published'); if (ip) ip.checked = !!node.isPublished;

                        const roles = li.querySelector('.node-roles'); if (roles) roles.value = node.rolesCsv ?? '';

                        // enforce your editor rules
                        normalizeLinkInputs(li);
                        setDeletedState(li, !!node.deleted);

                        // badges depend on flags + current state
                        updateVisibilityBadge(li);
                        updatePageWarnBadge(li);

                        // collapse UI needs re-eval after children are built
                        // (we call refreshAllToggles() after full rebuild)
                    }

                    function buildUl(ul, nodes) {
                        // Rebuild order exactly
                        ul.innerHTML = '';

                        (nodes || []).forEach(node => {
                            const nodeId = String(node.id ?? '');

                            let li = existingById.get(nodeId);
                            if (!li) {
                                // ✅ recreate missing nodes (Undo/Redo add/remove)
                                li = createNodeLi();                // <-- no args
                                li.dataset.id = nodeId;             // enforce snapshot id
                                newlyCreated.push(li);
                            }

                            setFields(li, node);
                            ul.appendChild(li);

                            const childUl = ensureChildrenUl(li);
                            buildUl(childUl, node.children || []);
                        });
                    }

                    buildUl(navRoot, snap.tree || []);

                    // ✅ wire new nodes (events + link rules + etc.)
                    // Reused nodes already have handlers, new ones do not.
                    newlyCreated.forEach(li => {
                        wireNodeUi(li);

                        // init sortable for its child UL (if any)
                        const childUl = li.querySelector(':scope > .nav-children');
                        if (childUl) initSortable(childUl);
                    });

                    // ✅ safest: re-init sortables globally (in case structure changed)
                    initAllSortables();

                    // refresh derived UI
                    applyShowDeletedUi();
                    refreshAllToggles();
                    refreshAllBadges();
                    refreshSortBadges();

                    setDirty(true);
                } finally {
                    historyApplying = false;
                    updateUndoRedoUi();
                }
            }


            function undo() {
                if (undoStack.length <= 1) return;
                const current = undoStack.pop();
                redoStack.push(current);

                const prev = undoStack[undoStack.length - 1];
                applySnapshot(prev.json);

                showToast('Undo', 'info');
            }

            function redo() {
                if (redoStack.length === 0) return;
                const next = redoStack.pop();
                undoStack.push(next);

                applySnapshot(next.json);

                showToast('Redo', 'info');
            }

            // -----------------------------
            // Node wiring
            // -----------------------------
            function setDeletedState(li, deleted) {
                li.dataset.deleted = deleted ? 'true' : 'false';
                li.classList.toggle('is-deleted', !!deleted);

                li.querySelectorAll('input, select, textarea').forEach(el => {
                    el.disabled = !!deleted;
                });

                const addChildBtn = li.querySelector('.add-child');
                if (addChildBtn) addChildBtn.disabled = !!deleted;

                const delBtn = li.querySelector('.delete-node');
                const restoreBtn = li.querySelector('.restore-node');

                if (delBtn) delBtn.classList.toggle('d-none', !!deleted);
                if (restoreBtn) restoreBtn.classList.toggle('d-none', !deleted);

                updateVisibilityBadge(li);
                updatePageWarnBadge(li);
            }

            // ✅ Reduced duplicate autosave triggers:
            // - label autosaves on input
            // - other controls autosave on change
            function wireAutosaveOnFieldChange(li) {
                // label typing
                li.querySelectorAll('input.node-label').forEach(el => {
                    let enterCommitted = false;

                    el.addEventListener('input', () => {
                        if (historyApplying) return;
                        setDirty(true);
                        updateVisibilityBadge(li);
                        updatePageWarnBadge(li);
                        autoSaveDebounced();
                    });

                    el.addEventListener('keydown', (e) => {
                        if (e.key !== 'Enter') return;

                        e.preventDefault();
                        if (historyApplying) return;

                        enterCommitted = true;
                        pushHistory('label');
                        el.blur();
                    });

                    el.addEventListener('blur', () => {
                        if (historyApplying) return;

                        if (enterCommitted) {
                            enterCommitted = false;
                            return;
                        }
                        pushHistory('label');
                    });
                });

                // change-based controls
                li.querySelectorAll('select, input[type="checkbox"], input[type="radio"], input.node-url').forEach(el => {
                    el.addEventListener('change', () => {
                        if (historyApplying) return;

                        setDirty(true);

                        if (el.classList.contains('node-linktype')) {
                            setLinkType(li, el.value);
                        }
                        if (el.classList.contains('node-pageid') || el.classList.contains('node-url')) {
                            normalizeLinkInputs(li);
                        }

                        pushHistory('change');

                        updateVisibilityBadge(li);
                        updatePageWarnBadge(li);
                        autoSaveDebounced();
                    });
                });
            }

            function wireNodeUi(li) {
                const toggleBtn = li.querySelector('.toggle-children');
                if (toggleBtn) {
                    toggleBtn.addEventListener('click', () => {
                        const ul = li.querySelector(':scope > .nav-children');
                        if (!ul) return;

                        ul.classList.toggle('d-none');
                        const collapsed = ul.classList.contains('d-none');
                        toggleBtn.textContent = collapsed ? '▶' : '▼';
                        localStorage.setItem(collapseKeyFor(li), collapsed ? 'true' : 'false');
                    });
                }

                li.querySelector('.add-child')?.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (historyApplying) return;

                    const parentChildUl = li.querySelector(':scope > .nav-children');
                    if (!parentChildUl) return;

                    const childLi = createNodeLi();
                    parentChildUl.appendChild(childLi);

                    // ensure parent toggle shows
                    applyCollapseState(li);

                    refreshSortBadges();
                    refreshAllBadges();

                    setDirty(true);
                    pushHistory('add-child');
                    autoSaveDebounced();

                    childLi.querySelector('.node-label')?.focus({ preventScroll: true });
                    childLi.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });


                li.querySelector('.delete-node')?.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (historyApplying) return;

                    setDeletedState(li, true);
                    pushHistory('delete');
                    applyShowDeletedUi();

                    const parentLi = li.closest('ul')?.closest('li.nav-node');
                    if (parentLi) applyCollapseState(parentLi);

                    refreshSortBadges();
                    setDirty(true);
                    autoSaveDebounced();
                });

                li.querySelector('.restore-node')?.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (historyApplying) return;

                    setDeletedState(li, false);
                    pushHistory('restore');
                    applyShowDeletedUi();

                    const parentLi = li.closest('ul')?.closest('li.nav-node');
                    if (parentLi) applyCollapseState(parentLi);

                    refreshSortBadges();
                    setDirty(true);
                    autoSaveDebounced();
                });

                normalizeLinkInputs(li);
                applyCollapseState(li);
                updateVisibilityBadge(li);
                updatePageWarnBadge(li);
                wireAutosaveOnFieldChange(li);
            }

            function wireExistingNodes() {
                navRoot?.querySelectorAll('.nav-node').forEach(li => {
                    wireNodeUi(li);
                    const childrenUl = li.querySelector(':scope > .nav-children');
                    initSortable(childrenUl);
                });

                refreshAllToggles();
                refreshAllBadges();
                refreshSortBadges();
            }

            // -----------------------------
            // Refresh helpers
            // -----------------------------
            function buildFlagsSnapshot(flagsObj) {
                const snap = {};
                Object.entries(flagsObj || {}).forEach(([k, f]) => {
                    const id = Number(k);
                    if (!id) return;
                    snap[id] = [
                        (f?.showInNavigation ? 1 : 0),
                        Number(f?.pageStatusId ?? -1),
                        (f?.isActive ? 1 : 0),
                        (f?.isDeleted ? 1 : 0)
                    ].join('|');
                });
                return snap;
            }

            function buildPagesSnapshot(pagesArr) {
                const snap = {};
                (Array.isArray(pagesArr) ? pagesArr : []).forEach(p => {
                    const id = Number(p.id ?? p.Id ?? 0);
                    if (!id) return;
                    const title = String(p.title ?? p.Title ?? '');
                    const slug = String(p.slug ?? p.Slug ?? '');
                    snap[id] = `${title}|${slug}`;
                });
                return snap;
            }

            function diffSnapshotCounts(prev, next) {
                let changed = 0, added = 0, removed = 0;

                const prevKeys = new Set(Object.keys(prev || {}));
                const nextKeys = new Set(Object.keys(next || {}));

                nextKeys.forEach(k => { if (!prevKeys.has(k)) added++; });
                prevKeys.forEach(k => { if (!nextKeys.has(k)) removed++; });
                nextKeys.forEach(k => {
                    if (prevKeys.has(k) && prev[k] !== next[k]) changed++;
                });

                return { changed, added, removed };
            }

            function diffChangedIds(prevSnap, nextSnap) {
                const changedIds = [];
                const prevKeys = new Set(Object.keys(prevSnap || {}));
                const nextKeys = new Set(Object.keys(nextSnap || {}));

                nextKeys.forEach(k => { if (!prevKeys.has(k)) changedIds.push(Number(k)); });
                prevKeys.forEach(k => { if (!nextKeys.has(k)) changedIds.push(Number(k)); });

                nextKeys.forEach(k => {
                    if (prevKeys.has(k) && prevSnap[k] !== nextSnap[k]) changedIds.push(Number(k));
                });

                return Array.from(new Set(changedIds.filter(n => !Number.isNaN(n) && n > 0)));
            }

            function maybeToastRefreshChanged(message) {
                const now = Date.now();
                if (now - lastRefreshToastAt < 6000) return;
                showToast(message || 'Page data updated', 'info');
                lastRefreshToastAt = now;
            }

            function formatRefreshToast(flagsDelta, pagesDelta) {
                const parts = [];

                if ((flagsDelta.changed + flagsDelta.added + flagsDelta.removed) > 0) {
                    const bits = [];
                    if (flagsDelta.changed) bits.push(`${flagsDelta.changed} status changed`);
                    if (flagsDelta.added) bits.push(`${flagsDelta.added} new`);
                    if (flagsDelta.removed) bits.push(`${flagsDelta.removed} removed`);
                    parts.push(`Pages: ${bits.join(', ')}`);
                }

                if ((pagesDelta.changed + pagesDelta.added + pagesDelta.removed) > 0) {
                    const bits = [];
                    if (pagesDelta.added) bits.push(`${pagesDelta.added} added`);
                    if (pagesDelta.removed) bits.push(`${pagesDelta.removed} removed`);
                    if (pagesDelta.changed) bits.push(`${pagesDelta.changed} renamed`);
                    parts.push(`Options: ${bits.join(', ')}`);
                }

                return parts.length ? parts.join(' • ') : 'Page data updated';
            }

            async function refreshPageFlagsFromServer() {
                try {
                    const res = await fetch(`?handler=PageFlags&menuId=${menuId}`, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    });

                    const data = await res.json().catch(() => null);
                    if (!res.ok || !data || !data.success) return null;

                    const nextFlags = data.flags || {};
                    const nextSnap = buildFlagsSnapshot(nextFlags);

                    const prevSnap = lastFlagsSnapshot;
                    const changedIds = diffChangedIds(prevSnap, nextSnap);
                    const delta = diffSnapshotCounts(prevSnap, nextSnap);

                    Object.keys(pageFlagsById).forEach(k => delete pageFlagsById[k]);
                    Object.entries(nextFlags).forEach(([k, v]) => pageFlagsById[k] = v);

                    lastFlagsSnapshot = nextSnap;

                    if (delta.changed || delta.added || delta.removed) {
                        refreshAllBadges();
                    }

                    for (const [pid, sig] of ackDangerByPageId.entries()) {
                        const nowSig = nextSnap[String(pid)];
                        if (!nowSig || nowSig !== sig) ackDangerByPageId.delete(pid);
                    }
                    saveAckToStorage();

                    return { delta, changedIds };
                } catch {
                    return null;
                }
            }

            async function refreshPageOptionsFromServer() {
                try {
                    const res = await fetch(`?handler=PageOptions&menuId=${menuId}`, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    });

                    const data = await res.json().catch(() => null);
                    if (!res.ok || !data || !data.success) return null;

                    const nextPages = data.pages || [];
                    const nextSnap = buildPagesSnapshot(nextPages);

                    const prevSnap = lastPagesSnapshot;
                    const changedIds = diffChangedIds(prevSnap, nextSnap);
                    const delta = diffSnapshotCounts(prevSnap, nextSnap);

                    pages = nextPages;
                    lastPagesSnapshot = nextSnap;

                    if (delta.changed || delta.added || delta.removed) {
                        navRoot?.querySelectorAll('.nav-node').forEach(li => {
                            const sel = li.querySelector('.node-pageid');
                            if (!sel) return;
                            const current = sel.value || '';
                            sel.innerHTML = `<option value="">-- Select page --</option>${renderPageOptions(current)}`;
                        });

                        refreshAllBadges();
                    }

                    return { delta, changedIds };
                } catch {
                    return null;
                }
            }

            function isUserInteractingWithEditor() {
                const el = document.activeElement;
                if (!el) return false;
                return !!(el.closest && el.closest('#navRoot .nav-node'));
            }

            function markAutoExpanded(parentLi) {
                const btn = parentLi.querySelector(':scope .toggle-children');
                if (!btn) return;

                btn.classList.remove('auto-expand-blink');
                void btn.offsetWidth;
                btn.classList.add('auto-expand-blink');

                let pill = parentLi.querySelector(':scope .auto-expand-pill');
                if (!pill) {
                    pill = document.createElement('span');
                    pill.className = 'auto-expand-pill';
                    pill.textContent = 'Auto-expanded';
                    btn.insertAdjacentElement('afterend', pill);
                }

                setTimeout(() => {
                    btn.classList.remove('auto-expand-blink');
                    pill?.remove();
                }, 2200);
            }

            function expandAncestors(li) {
                let current = li;

                while (true) {
                    const parentLi = current.closest('ul')?.closest('li.nav-node');
                    if (!parentLi) break;

                    const ul = parentLi.querySelector(':scope > .nav-children');
                    const btn = parentLi.querySelector(':scope .toggle-children');

                    if (ul) {
                        const wasCollapsed =
                            ul.classList.contains('d-none') ||
                            localStorage.getItem(collapseKeyFor(parentLi)) === 'true';

                        if (wasCollapsed) {
                            ul.classList.remove('d-none');
                            localStorage.setItem(collapseKeyFor(parentLi), 'false');
                            if (btn) btn.textContent = '▼';
                            markAutoExpanded(parentLi);
                        }
                    }

                    applyCollapseState(parentLi);
                    current = parentLi;
                }
            }

            function getPageSeverity(pageId) {
                const f = pageFlagsById[String(pageId)] || pageFlagsById[pageId];
                if (!f) return 'info';

                const isDeleted = !!f.isDeleted;
                const isActive = f.isActive !== false;
                const isPublished = (typeof f.pageStatusId === 'number')
                    ? (f.pageStatusId === PAGE_STATUS_PUBLISHED)
                    : true;

                const showInNav = f.showInNavigation !== false;

                const hard = isDeleted || !isActive || !isPublished;
                if (hard) return 'danger';
                if (!showInNav) return 'warning';
                return 'info';
            }

            function pulseNavNodesForPageIds(pageIds) {
                if (!pageIds || pageIds.length === 0) return;

                const set = new Set(pageIds.map(Number));

                navRoot?.querySelectorAll('.nav-node').forEach(li => {
                    const linkType = (li.querySelector('.node-linktype')?.value || 'page').toLowerCase();
                    if (linkType !== 'page') return;

                    const raw = li.querySelector('.node-pageid')?.value || '';
                    const pid = raw ? Number(raw) : 0;
                    if (!(pid > 0) || !set.has(pid)) return;

                    const sev = getPageSeverity(pid);

                    if (sev === 'danger') {
                        if (isDangerAcked(pid)) return;
                        expandAncestors(li);
                        setDangerAck(pid, true);
                        saveAckToStorage();
                    }

                    li.classList.remove('pulse-danger', 'pulse-warning', 'pulse-info');
                    void li.offsetWidth;
                    li.classList.add(sev === 'danger' ? 'pulse-danger' : sev === 'warning' ? 'pulse-warning' : 'pulse-info');

                    setTimeout(() => {
                        li.classList.remove('pulse-danger', 'pulse-warning', 'pulse-info');
                    }, 1300);
                });
            }

            async function periodicRefreshTick() {
                if (isSaving || saveInFlight) return;
                if (isDirty) return;
                if (document.hidden) return;
                if (isUserInteractingWithEditor()) return;

                const flagsRes = await refreshPageFlagsFromServer();
                const pagesRes = await refreshPageOptionsFromServer();

                if (!flagsRes && !pagesRes) return;

                const f = flagsRes?.delta || { changed: 0, added: 0, removed: 0 };
                const p = pagesRes?.delta || { changed: 0, added: 0, removed: 0 };

                const ids = Array.from(new Set([
                    ...(flagsRes?.changedIds || []),
                    ...(pagesRes?.changedIds || [])
                ]));

                if ((f.changed + f.added + f.removed + p.changed + p.added + p.removed) > 0) {
                    maybeToastRefreshChanged(formatRefreshToast(f, p));
                    pulseNavNodesForPageIds(ids);
                }
            }

            function startPeriodicRefresh() {
                setTimeout(() => { periodicRefreshTick(); }, 2500);
                setInterval(() => { periodicRefreshTick(); }, REFRESH_MS);

                document.addEventListener('visibilitychange', () => {
                    if (!document.hidden) periodicRefreshTick();
                });

                window.addEventListener('focus', () => {
                    periodicRefreshTick();
                });
            }

        // -----------------------------
        // Init
        // -----------------------------
        document.addEventListener('DOMContentLoaded', () => {
            updateSaveButtonUi();

            initAllSortables();
            wireExistingNodes();

            // snapshots
            lastFlagsSnapshot = buildFlagsSnapshot(pageFlagsById);
            lastPagesSnapshot = buildPagesSnapshot(pages);

            // load + prune ack
            loadAckFromStorage();
            for (const [pid, sig] of ackDangerByPageId.entries()) {
                const nowSig = lastFlagsSnapshot[String(pid)];
                if (!nowSig || nowSig !== sig) ackDangerByPageId.delete(pid);
            }
            saveAckToStorage();

            // deleted toggle
            document.getElementById('toggleDeletedBtn')?.addEventListener('click', () => {
                const next = !getShowDeletedPref();
                setShowDeletedPref(next);
                applyShowDeletedUi();
            });

                // -----------------------------
                // Add Root
                // -----------------------------
                document.getElementById('addRootBtn')?.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (!navRoot) return;
                    if (historyApplying) return;

                    // snapshot BEFORE change (so Undo returns to previous state)
                    pushHistory('pre-add-root');

                    const li = createNodeLi();      // your factory returns <li>
                    navRoot.appendChild(li);

                    // keep derived UI consistent
                    refreshSortBadges();
                    refreshAllBadges();
                    refreshAllToggles();

                    setDirty(true);

                    // snapshot AFTER change (so Redo can re-apply)
                    pushHistory('add-root');

                    autoSaveDebounced();

                    li.querySelector('.node-label')?.focus({ preventScroll: true });
                    li.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });

                // -----------------------------
                // Save buttons
                // -----------------------------
                document.getElementById('saveBtn')?.addEventListener('click', async (e) => {
                    e.preventDefault();
                    if (isSaving) return;
                    await save();
                });

                document.getElementById('saveViewBtn')?.addEventListener('click', async (e) => {
                    e.preventDefault();
                    if (isSaving) return;

                    const ok = await save();
                    if (!ok) return;

                    window.open(publicBaseUrl, '_blank');
                });

                // -----------------------------
                // Undo/Redo baseline + wiring
                // -----------------------------
                pushHistory('baseline');
                updateUndoRedoUi();

                document.getElementById('undoBtn')?.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (historyApplying) return;
                    undo();
                });

                document.getElementById('redoBtn')?.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (historyApplying) return;
                    redo();
                });

                // Keyboard shortcuts (Ctrl/Cmd+Z, Ctrl/Cmd+Y / Shift+Ctrl+Z)
                document.addEventListener('keydown', (e) => {
                    if (historyApplying) return;

                    const isMac = navigator.platform.toUpperCase().includes('MAC');
                    const mod = isMac ? e.metaKey : e.ctrlKey;
                    if (!mod) return;

                    // avoid stealing shortcuts while typing in inputs
                    const tag = (document.activeElement?.tagName || '').toLowerCase();
                    const isTyping = tag === 'input' || tag === 'textarea' || tag === 'select';
                    if (isTyping) return;

                    const key = (e.key || '').toLowerCase();
                    if (key === 'z' && !e.shiftKey) { e.preventDefault(); undo(); }
                    else if (key === 'y' || (key === 'z' && e.shiftKey)) { e.preventDefault(); redo(); }
                });

                // -----------------------------
                // Other init steps
                // -----------------------------
                wireBadgeAckToggle();
                applyShowDeletedUi();
                startPeriodicRefresh();
            });

            window.addEventListener('beforeunload', (e) => {
                if (!isDirty) return;
                if (isSaving) return;
                e.preventDefault();
                e.returnValue = '';
            });


        })();
    </script>
}
