@page
@model WebsiteBuilder.IRF.Pages.Admin.Domains.CreateModel
@{
    ViewData["Title"] = "Add Domain";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">Add Domain</h2>
        <div class="text-muted small">Create a domain mapping and verify ownership via DNS TXT</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Admin/Domains/Index">Back</a>
</div>

@if (!ModelState.IsValid)
{
    <div class="alert alert-danger">Please fix the errors below.</div>
}

<div class="card">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Domain</label>
                <input asp-for="Input.Host" class="form-control" placeholder="example.com or www.example.com" />
                <span asp-validation-for="Input.Host" class="text-danger small"></span>
                <div class="text-muted small mt-1">We will normalize/validate this host and generate a verification token.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">SSL Mode</label>
                <select asp-for="Input.SslModeId" class="form-select">
                    <option value="1">None</option>
                    <option value="2">External</option>
                    <option value="3">Managed</option>
                </select>
                <div class="text-muted small mt-1">You can keep External for now (CDN/edge terminates TLS).</div>
            </div>

            <button class="btn btn-primary" type="submit">Create Mapping</button>
        </form>
    </div>
</div>

@if (Model.Created is not null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="mb-2">DNS Verification</h5>
            <div class="text-muted small mb-3">Create the TXT record below, then click Verify on the Domains list.</div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">TXT Host/Name</label>
                    <div class="input-group">
                        <input class="form-control" readonly value="@Model.DnsHost" />
                        <button type="button" class="btn btn-outline-secondary" data-copy="@Model.DnsHost">Copy</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">TXT Value</label>
                    <div class="input-group">
                        <input class="form-control" readonly value="@Model.DnsValue" />
                        <button type="button" class="btn btn-outline-secondary" data-copy="@Model.DnsValue">Copy</button>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <div class="text-muted small">Normalized host stored:</div>
                <div class="fw-semibold">@Model.Created.NormalizedHost</div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <a class="btn btn-success" asp-page="/Admin/Domains/Index">Go to Domains</a>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
          function copyToClipboard(text) {
            if (navigator.clipboard && window.isSecureContext) {
              return navigator.clipboard.writeText(text);
            }
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.left = "-9999px";
            document.body.appendChild(ta);
            ta.focus(); ta.select();
            document.execCommand("copy");
            document.body.removeChild(ta);
            return Promise.resolve();
          }

          document.addEventListener("click", async (e) => {
            const btn = e.target.closest("[data-copy]");
            if (!btn) return;
            const txt = btn.getAttribute("data-copy") || "";
            try {
              await copyToClipboard(txt);
              btn.innerText = "Copied!";
              setTimeout(() => btn.innerText = "Copy", 900);
            } catch {
              alert("Copy failed:\n\n" + txt);
            }
          });
        })();
    </script>
}