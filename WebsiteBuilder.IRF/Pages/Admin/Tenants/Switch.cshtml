@page
@model WebsiteBuilder.IRF.Pages.Admin.Tenants.SwitchModel

@{
    ViewData["Title"] = "Switch Tenant";

    string? current = null;
    if (Request.Cookies.TryGetValue("wb.admin.tenant", out var cookieVal))
    {
        current = cookieVal;
    }

    var isSelected = Model.Input.TenantId != Guid.Empty;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">Switch Tenant</h2>
        <div class="text-muted small">
            Select which tenant you want to manage in the Admin area.
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="button"
                class="btn btn-outline-secondary"
                onclick="postClearTenant('@(Model.Input.ReturnUrl ?? "/Admin")')">
            Clear selection
        </button>

        <a class="btn btn-outline-secondary" href="@(Model.Input.ReturnUrl ?? "/Admin")">
            Back
        </a>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        Please fix the errors below and try again.
    </div>
}

<form method="post" class="card">
    <div class="card-body">
        <input type="hidden" asp-for="Input.ReturnUrl" />

        <div class="mb-2">
            <label class="form-label">Tenant</label>
            <div class="text-muted small">
                Tip: You can still manage only the tenants you own unless you are an Admin/SuperAdmin.
            </div>
        </div>

        @if (Model.Tenants == null || Model.Tenants.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                No tenants available for your account.
            </div>
        }
        else
        {
            <div class="list-group">
                @for (var i = 0; i < Model.Tenants.Count; i++)
                {
                    var t = Model.Tenants[i];
                    var selected = Model.Input.TenantId == t.Id;

                    <label class="list-group-item d-flex align-items-start gap-3">
                        <input class="form-check-input mt-1"
                               type="radio"
                               name="Input.TenantId"
                               value="@t.Id"
                               checked="@(selected ? "checked" : null)" />

                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <div class="fw-semibold">
                                    @t.DisplayName
                                </div>

                                <div class="d-flex gap-2 align-items-center">
                                    @if (!string.IsNullOrWhiteSpace(t.PrimaryDomain))
                                    {
                                        <span class="badge text-bg-light border">
                                            @t.PrimaryDomain
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light border">
                                            @($"{t.Slug}.(platform)")
                                        </span>
                                    }

                                    @if (t.IsOwnedByMe)
                                    {
                                        <span class="badge text-bg-success">Owned</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Shared</span>
                                    }
                                </div>
                            </div>

                            <div class="text-muted small mt-1">
                                <code>@t.Slug</code>
                                · @t.PagesCount page@(t.PagesCount == 1 ? "" : "s")
                                @if (!string.IsNullOrWhiteSpace(current) && Guid.TryParse(current, out var curId) && curId == t.Id)
                                {
                                    <span class="ms-2 badge text-bg-primary">Current</span>
                                }
                            </div>
                        </div>
                    </label>
                }
            </div>

            <div class="text-danger small mt-2">
                @Html.ValidationMessageFor(m => m.Input.TenantId)
            </div>

            <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn btn-primary" @(isSelected ? null : "disabled")>
                    Use selected tenant
                </button>
            </div>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const btn = document.querySelector('form.card button[type="submit"].btn.btn-primary');
            const radios = document.querySelectorAll('input[type="radio"][name="Input.TenantId"]');

            function update() {
                if (!btn) return;
                const anyChecked = Array.from(radios).some(r => r.checked);
                btn.disabled = !anyChecked;
            }

            radios.forEach(r => r.addEventListener('change', update));
            update();
        })();

        function postClearTenant(returnUrl) {
            // Build a tiny form to POST to ?handler=Clear
            const f = document.createElement("form");
            f.method = "post";
            f.action = window.location.pathname + "?handler=Clear";

            const ru = document.createElement("input");
            ru.type = "hidden";
            ru.name = "returnUrl";
            ru.value = returnUrl || "/Admin";
            f.appendChild(ru);

            document.body.appendChild(f);
            f.submit();
        }
    </script>
}
