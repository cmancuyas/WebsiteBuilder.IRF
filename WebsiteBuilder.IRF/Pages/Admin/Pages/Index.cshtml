@page
@model WebsiteBuilder.IRF.Pages.Admin.Pages.IndexModel
@{
    ViewData["Title"] = "Pages";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Pages</h2>
    <a class="btn btn-primary" asp-page="/Admin/Pages/Create">New Page</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Slug</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@p.Title</td>
                        <td><code>@p.Slug</code></td>
                        <td>
                            @if (p.IsArchived)
                            {
                                <span class="badge bg-secondary">Archived</span>
                            }
                            else if (p.PublishedRevisionId != null)
                            {

                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {

                                <span class="badge bg-warning text-dark">Draft</span>
                            }

                            @if (p.DraftRevisionId != null)
                            {
                                <span class="badge bg-info text-dark ms-1">Has Draft</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Pages/Edit" asp-route-id="@p.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Pages/Revisions" asp-route-id="@p.Id">Revisions</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
