@page
@model WebsiteBuilder.IRF.Pages.Admin.Pages.IndexModel

@if (User.IsInRole(WebsiteBuilder.IRF.Infrastructure.Auth.AppRoles.SuperAdmin) ||
     User.IsInRole(WebsiteBuilder.IRF.Infrastructure.Auth.AppRoles.Admin))
{
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="mb-2">Tenant Home Page</h6>

            <form method="post" asp-page-handler="SetHomePage" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()

                <div class="col-12 col-md-8">
                    <label class="form-label mb-1">Select a published page</label>

                    <select class="form-select" asp-for="SelectedHomePageId">
                        <option value="">-- Select Home Page --</option>
                        @foreach (var opt in Model.PublishedPagesSelect)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.SelectedHomePageId?.ToString())">
                                @opt.Text
                            </option>
                        }
                    </select>

                    <div class="form-text">
                        This is where <code>/</code> will redirect for this tenant.
                    </div>

                    <span class="text-danger">
                        @Html.ValidationMessageFor(m => m.SelectedHomePageId)
                    </span>
                </div>

                <div class="col-12 col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        Set as Home
                    </button>
                </div>
            </form>

            @* Optional: show only "global" errors *@
            @if (ViewData.ModelState.TryGetValue(string.Empty, out var entry) && entry.Errors.Count > 0)
            {
                <div class="text-danger mt-2">
                    @foreach (var err in entry.Errors)
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }
        </div>
    </div>
}
