@page "{id:int}"
@model WebsiteBuilder.IRF.Pages.Admin.Pages.EditModel
@{
    ViewData["Title"] = "Edit Page";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">@Model.PageTitle</h2>
        <div class="text-muted small">/<span>@(string.IsNullOrEmpty(Model.PageSlug) ? "" : Model.PageSlug)</span></div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Pages/Index">Back</a>

        @if (Model.CanPublish)
        {
            <form method="post" asp-page-handler="Publish">
                <button class="btn btn-success" type="submit">Publish</button>
            </form>
        }

        @if (Model.CanRestoreDraft)
        {
            <a class="btn btn-outline-primary" asp-page="/Admin/Pages/Revisions" asp-route-id="@Model.Id">
                Revisions
            </a>
        }
    </div>
    <a class="btn btn-outline-secondary"
       asp-page="/Admin/Pages/Sections"
       asp-route-id="@Model.Id">
        Manage Sections
    </a>

</div>

@if (!string.IsNullOrWhiteSpace(Model.Banner))
{
    <div class="alert alert-info">@Model.Banner</div>
}

<div class="card">
    <div class="card-body">
        <form method="post" asp-page-handler="Save">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Title</label>
                    <input asp-for="Input.Title" class="form-control" />
                    <span asp-validation-for="Input.Title" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Slug</label>
                    <input asp-for="Input.Slug" class="form-control" />
                    <div class="form-text">Empty = home.</div>
                    <span asp-validation-for="Input.Slug" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Layout Key</label>
                    <input asp-for="Input.LayoutKey" class="form-control" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Show in Navigation</label>
                    <div class="form-check form-switch">
                        <input asp-for="Input.ShowInNavigation" class="form-check-input" />
                        <label class="form-check-label" asp-for="Input.ShowInNavigation">Enabled</label>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">Meta Title</label>
                    <input asp-for="Input.MetaTitle" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label">Meta Description</label>
                    <textarea asp-for="Input.MetaDescription" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-semibold">Sections</div>
                    <div class="text-muted small">
                        Draft sections: @Model.SectionCount
                    </div>
                </div>

                <a class="btn btn-outline-secondary"
                   asp-page="/Admin/Pages/Revisions"
                   asp-route-id="@Model.Id">
                    Manage Sections / Revisions
                </a>
            </div>

            <div class="mt-3 d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Save Draft</button>
            </div>
        </form>
    </div>
</div>

@if (Model.PublishedInfo is not null)
{
    <div class="card mt-3">
        <div class="card-body">
            <div class="fw-semibold">Published</div>
            <div class="text-muted small">
                Revision #@Model.PublishedInfo.VersionNumber · Slug: <code>@Model.PublishedInfo.Slug</code>
                @if (Model.PublishedInfo.PublishedAt is not null)
                {
                    <span>· @Model.PublishedInfo.PublishedAt</span>
                }
            </div>

            @if (!Model.HasDraft && Model.PublishedInfo is not null)
            {
                <form method="post" asp-page-handler="RestoreDraft" class="mt-2">
                    <input type="hidden" name="revisionId" value="@Model.PublishedInfo.Id" />
                    <button class="btn btn-outline-primary" type="submit">Restore Draft From Published</button>
                </form>
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
