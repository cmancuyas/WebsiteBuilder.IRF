@page "{id:int}"
@using System.Text.Json
@model WebsiteBuilder.IRF.Pages.Admin.Pages.EditModel
@{
    ViewData["Title"] = "Edit Page";
}

<form id="antiForgeryForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">@Model.PageTitle</h2>
        <div class="text-muted small">/<span>@(string.IsNullOrEmpty(Model.PageSlug) ? "" : Model.PageSlug)</span></div>
    </div>

    <div class="d-flex gap-2 align-items-center">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Pages/Index">Back</a>

        @* ✅ Standalone publish form (not nested) *@
        @if (Model.CanPublish)
        {
            <form method="post" asp-page-handler="Publish" class="m-0">
                @Html.AntiForgeryToken()
                <button class="btn btn-success" type="submit">Publish</button>
            </form>
        }

        @if (Model.CanRestoreDraft)
        {
            <a class="btn btn-outline-primary" asp-page="/Admin/Pages/Revisions" asp-route-id="@Model.Id">
                Revisions
            </a>
        }
    </div>
</div>

@* ✅ Publish validation errors MUST be outside the flex header *@
@if (Model.PublishValidationErrors?.Count > 0)
{
    <div class="alert alert-danger mb-3">
        <div class="fw-semibold mb-2">Publish blocked due to invalid section settings:</div>

        <ul class="mb-0">
            @foreach (var e in Model.PublishValidationErrors)
            {
                if (e.SectionId == 0)
                {
                    foreach (var msg in e.Messages)
                    {
                        <li>@msg</li>
                    }
                }
                else
                {
                    <li>
                        <a href="#section-@e.SectionId" class="text-decoration-underline">
                            Section #@e.SectionId (@e.TypeKey)
                        </a>

                        <ul class="mb-0">
                            @foreach (var msg in e.Messages)
                            {
                                <li>@msg</li>
                            }
                        </ul>
                    </li>
                }
            }
        </ul>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Banner))
{
    <div class="alert alert-info">@Model.Banner</div>
}

<div class="card">
    <div class="card-body">
        @* ✅ Main Save form (single form only) *@
        <form id="pageEditForm" method="post" asp-page-handler="Save">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Title</label>
                    <input asp-for="Input.Title" class="form-control" />
                    <span asp-validation-for="Input.Title" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Slug</label>
                    <input asp-for="Input.Slug" class="form-control" />
                    <div class="form-text">Empty = home.</div>
                    <span asp-validation-for="Input.Slug" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Layout Key</label>
                    <input asp-for="Input.LayoutKey" class="form-control" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Show in Navigation</label>
                    <div class="form-check form-switch">
                        <input asp-for="Input.ShowInNavigation" class="form-check-input" />
                        <label class="form-check-label" asp-for="Input.ShowInNavigation">Enabled</label>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">Meta Title</label>
                    <input asp-for="Input.MetaTitle" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label">Meta Description</label>
                    <textarea asp-for="Input.MetaDescription" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <hr class="my-4" />

            @* ✅ Sections header *@
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-semibold">Sections</div>
                    <div class="text-muted small">
                        Draft sections: @Model.SectionCount
                        @if (!Model.HasDraft)
                        {
                            <span class="ms-2 badge text-bg-warning">No Draft</span>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-primary"
                            id="addSectionBtn"
                            data-bs-toggle="modal"
                            data-bs-target="#addSectionModal"
                            @(Model.HasDraft ? null : "disabled")>
                        Add Section
                    </button>

                    <a class="btn btn-outline-secondary"
                       asp-page="/Admin/Pages/Sections"
                       asp-route-id="@Model.Id">
                        Manage Sections / Revisions
                    </a>
                </div>
            </div>

            <div id="sectionsHost" class="mt-3">
                @if (!Model.HasDraft)
                {
                    <div class="alert alert-warning mb-0">
                        No draft exists for this page. Restore a draft from a published revision to edit sections.
                    </div>
                }
                else if (Model.SectionCount == 0)
                {
                    <div class="alert alert-light border mb-0" id="noSectionsAlert">
                        No sections yet. Use <strong>Add Section</strong> to add sections.
                    </div>
                }
                else
                {
                    <div id="sectionsList" class="d-grid gap-2">
                        @foreach (var row in Model.SectionRows)
                        {
                            <partial name="Partials/_PageRevisionSectionRow" model="row" />
                        }
                    </div>
                }
            </div>

            <div class="mt-3 d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Save Draft</button>
            </div>
        </form>
    </div>
</div>

@* ✅ Add Section Modal *@
<div class="modal fade" id="addSectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Section</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <label class="form-label">Section Type</label>
                <select class="form-select" id="addSectionType">
                    <option value="">-- Select --</option>
                    @foreach (var opt in Model.SectionTypeOptions)
                    {
                        <option value="@opt.Value">@opt.Text</option>
                    }
                </select>

                <div class="mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="insertAtTop">
                        <label class="form-check-label" for="insertAtTop">Insert at top</label>
                    </div>

                    <label class="form-label mt-2">Insert after (optional)</label>
                    <select class="form-select" id="insertAfter">
                        <option value="">(Bottom)</option>
                        @foreach (var row in Model.SectionRows)
                        {
                            <option value="@row.RevisionSectionId">@row.Title</option>
                        }
                    </select>

                    <div class="form-text">
                        If “Insert at top” is checked, “Insert after” is ignored.
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmAddSectionBtn">Add</button>
            </div>
        </div>
    </div>
</div>

@if (Model.PublishedInfo is not null)
{
    <div class="card mt-3">
        <div class="card-body">
            <div class="fw-semibold">Published</div>
            <div class="text-muted small">
                Revision #@Model.PublishedInfo.VersionNumber · Slug: <code>@Model.PublishedInfo.Slug</code>
                @if (Model.PublishedInfo.PublishedAt is not null)
                {
                    <span>· @Model.PublishedInfo.PublishedAt</span>
                }
            </div>

            @if (!Model.HasDraft)
            {
                <form method="post" asp-page-handler="RestoreDraft" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="revisionId" value="@Model.PublishedInfo.Id" />
                    <button class="btn btn-outline-primary" type="submit">Restore Draft From Published</button>
                </form>
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const pageId = @Model.Id;

            // ✅ Draft revision concurrency token from EditModel.LoadAsync()
            let draftRevisionRowVersion =
                @Html.Raw(JsonSerializer.Serialize(Model.DraftRevisionRowVersionBase64 ?? ""));

            // ✅ publish-validation highlight list from server
            const invalidSectionIds =
                @Html.Raw(JsonSerializer.Serialize(
                    Model.PublishValidationErrors?
                            .Where(e => e.SectionId > 0)
                            .Select(e => e.SectionId)
                            .Distinct()
                            .ToList() ?? new List<int>()
                        ));

        function getAntiForgeryToken() {
            const el = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
            return el ? el.value : null;
        }

        async function postJson(url, body) {
            const token = getAntiForgeryToken();

            const res = await fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    ...(token ? { "RequestVerificationToken": token } : {})
                },
                body: JSON.stringify(body)
            });

            let json = null;
            try { json = await res.json(); } catch { }

            // ✅ Concurrency conflict
            if (res.status === 409) {
                const msg = json?.error || json?.message || "This draft was changed by someone else.";
                alert(msg + " Reloading…");
                window.location.reload();
                return null;
            }

            if (!res.ok || json?.ok === false) {
                const msg = json?.error || json?.message || ("Request failed: " + res.status);
                throw new Error(msg);
            }

            // ✅ Keep token fresh
            if (json?.draftRevisionRowVersion) {
                draftRevisionRowVersion = json.draftRevisionRowVersion;
            }

            return json;
        }

        // =========================
        // Publish validation highlight + scroll
        // =========================
        if (Array.isArray(invalidSectionIds) && invalidSectionIds.length) {
            invalidSectionIds.forEach(id => {
                const el = document.getElementById("section-" + id);
                if (el) el.classList.add("border", "border-danger");
            });

            const first = document.getElementById("section-" + invalidSectionIds[0]);
            if (first) first.scrollIntoView({ behavior: "smooth", block: "center" });
        }

        // =========================
        // Helpers: list + Sortable
        // =========================
        let sortableInstance = null;

        function ensureSectionsListExists() {
            let list = document.getElementById("sectionsList");
            if (list) return list;

            const host = document.getElementById("sectionsHost");
            if (!host) return null;

            const alertEl = document.getElementById("noSectionsAlert") || host.querySelector(".alert");
            if (alertEl) alertEl.remove();

            list = document.createElement("div");
            list.id = "sectionsList";
            list.className = "d-grid gap-2";
            host.appendChild(list);

            bindDeleteHandler(list);
            bindSortable(list);

            return list;
        }

        function currentOrder(list) {
            return Array.from(list.querySelectorAll('.section-item[data-revision-section-id]'))
                .map(el => Number(el.getAttribute('data-revision-section-id')))
                .filter(n => Number.isFinite(n) && n > 0);
        }

        async function persistOrder(list) {
            const orderedRevisionSectionIds = currentOrder(list);
            if (!orderedRevisionSectionIds.length)
                throw new Error("No sections found to reorder.");

            const url = `/Admin/Pages/Sections/${pageId}?handler=ReorderRevisionSections`;

            const payload = await postJson(url, {
                pageId,
                orderedRevisionSectionIds,
                draftRevisionRowVersion
            });

            if (payload?.missingFromClient || payload?.extraFromClient) {
                console.warn("Reorder mismatch details:", payload);
            }
        }

        function bindSortable(list) {
            if (!window.Sortable) return;

            if (sortableInstance && typeof sortableInstance.destroy === "function") {
                try { sortableInstance.destroy(); } catch { }
                sortableInstance = null;
            }

            sortableInstance = new Sortable(list, {
                animation: 150,
                handle: ".section-drag-handle",
                draggable: ".section-item",
                onEnd: async function () {
                    try {
                        await persistOrder(list);
                    } catch (err) {
                        alert(err.message || "Reorder failed.");
                        window.location.reload();
                    }
                }
            });
        }

        // =========================
        // DELETE (delegation)
        // =========================
        function bindDeleteHandler(list) {
            if (list.__deleteBound) return;
            list.__deleteBound = true;

            list.addEventListener("click", async (e) => {
                const btn = e.target.closest('[data-delete-revision-section]');
                if (!btn) return;

                const id = Number(btn.getAttribute("data-delete-revision-section"));
                if (!Number.isFinite(id) || id <= 0) return;

                if (!confirm("Delete this section?")) return;

                btn.disabled = true;

                try {
                    const url = `/Admin/Pages/Sections/${pageId}?handler=DeleteRevisionSection`;

                    await postJson(url, {
                        revisionSectionId: id,
                        draftRevisionRowVersion
                    });

                    const row = document.getElementById("section-" + id);
                    if (row) row.remove();

                    const insertAfterSelect = document.getElementById("insertAfter");
                    if (insertAfterSelect) {
                        const opt = insertAfterSelect.querySelector(`option[value="${id}"]`);
                        if (opt) opt.remove();
                    }

                    if (list.querySelectorAll(".section-item").length === 0) {
                        list.remove();
                        const host = document.getElementById("sectionsHost");
                        if (host) {
                            const msg = document.createElement("div");
                            msg.className = "alert alert-light border mb-0";
                            msg.id = "noSectionsAlert";
                            msg.innerHTML = 'No sections yet. Use <strong>Add Section</strong> to add sections.';
                            host.appendChild(msg);
                        }
                    }
                } catch (err) {
                    alert(err.message || "Delete failed.");
                    btn.disabled = false;
                }
            });
        }

        // Bind delete + sortable on load
        (function initExistingList() {
            const list = document.getElementById("sectionsList");
            if (!list) return;
            bindDeleteHandler(list);
            bindSortable(list);
        })();

        // =========================
        // Insert-at-top disables insert-after
        // =========================
        const insertAtTopEl = document.getElementById("insertAtTop");
        const insertAfterEl = document.getElementById("insertAfter");
        if (insertAtTopEl && insertAfterEl) {
            const sync = () => insertAfterEl.disabled = !!insertAtTopEl.checked;
            insertAtTopEl.addEventListener("change", sync);
            sync();
        }

        // =========================
        // ADD SECTION (AJAX - SectionsModel handler)
        // =========================
        const confirmAddBtn = document.getElementById("confirmAddSectionBtn");
        if (confirmAddBtn) {
            confirmAddBtn.addEventListener("click", async () => {
                const sectionTypeId = Number(document.getElementById("addSectionType")?.value || 0);
                const insertAtTop = !!document.getElementById("insertAtTop")?.checked;

                const afterRaw = document.getElementById("insertAfter")?.value || "";
                const insertAfterRevisionSectionId = afterRaw ? Number(afterRaw) : null;

                if (!sectionTypeId || sectionTypeId <= 0) {
                    alert("Please select a section type.");
                    return;
                }

                confirmAddBtn.disabled = true;

                try {
                    const url = `/Admin/Pages/Sections/${pageId}?handler=AddRevisionSection`;

                    const res = await postJson(url, {
                        pageId,
                        sectionTypeId,
                        insertAtTop,
                        insertAfterRevisionSectionId,
                        draftRevisionRowVersion
                    });

                    if (!res || !res.html) {
                        window.location.reload();
                        return;
                    }

                    const list = ensureSectionsListExists();
                    if (!list) throw new Error("Sections list host not found.");

                    if (insertAtTop) {
                        list.insertAdjacentHTML("afterbegin", res.html);
                    } else if (insertAfterRevisionSectionId) {
                        const afterRow = document.getElementById("section-" + insertAfterRevisionSectionId);
                        if (afterRow) afterRow.insertAdjacentHTML("afterend", res.html);
                        else list.insertAdjacentHTML("beforeend", res.html);
                    } else {
                        list.insertAdjacentHTML("beforeend", res.html);
                    }

                    const insertAfterSelect = document.getElementById("insertAfter");
                    if (insertAfterSelect && res.revisionSectionId) {
                        const opt = document.createElement("option");
                        opt.value = String(res.revisionSectionId);
                        opt.textContent = res.title || ("Section " + res.revisionSectionId);
                        insertAfterSelect.appendChild(opt);
                    }

                    try {
                        const modalEl = document.getElementById("addSectionModal");
                        const instance = bootstrap.Modal.getInstance(modalEl);
                        if (instance) instance.hide();
                    } catch { }

                    document.getElementById("addSectionType").value = "";
                    document.getElementById("insertAtTop").checked = false;
                    document.getElementById("insertAfter").value = "";
                    if (insertAfterEl) insertAfterEl.disabled = false;

                    bindSortable(list);

                    confirmAddBtn.disabled = false;
                } catch (err) {
                    alert(err.message || "Add section failed.");
                    confirmAddBtn.disabled = false;
                }
            });
        }

    })();
</script>
}
