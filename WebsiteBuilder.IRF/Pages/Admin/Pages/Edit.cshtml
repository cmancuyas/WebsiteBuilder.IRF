@page "{id:int}"
@using System.Text.Json
@model WebsiteBuilder.IRF.Pages.Admin.Pages.EditModel
@{
    ViewData["Title"] = "Edit Page";
}

<form id="antiForgeryForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">@Model.PageTitle</h2>
        <div class="text-muted small">/<span>@(string.IsNullOrEmpty(Model.PageSlug) ? "" : Model.PageSlug)</span></div>
    </div>

    <div class="d-flex gap-2 align-items-center">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Pages/Index">Back</a>

        @* ✅ Standalone publish form (not nested) *@
        @if (Model.CanPublish)
        {
            <form method="post" asp-page-handler="Publish" class="m-0">
                @Html.AntiForgeryToken()
                <button class="btn btn-success" type="submit">Publish</button>
            </form>
        }

        @if (Model.CanRestoreDraft)
        {
            <a class="btn btn-outline-primary" asp-page="/Admin/Pages/Revisions" asp-route-id="@Model.Id">
                Revisions
            </a>
        }
    </div>
</div>

@* ✅ Publish validation errors MUST be outside the flex header *@
@if (Model.PublishValidationErrors?.Count > 0)
{
    <div class="alert alert-danger mb-3">
        @{
            var invalidIdsCsv = string.Join(",",
            (Model.PublishValidationErrors ?? new())
            .Where(e => e.SectionId > 0)
            .Select(e => e.SectionId)
            .Distinct()
            );
        }

        <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="fw-semibold">Publish blocked due to invalid section settings:</div>

            @if (!string.IsNullOrWhiteSpace(invalidIdsCsv))
            {
                <a class="btn btn-sm btn-outline-light"
                   asp-page="/Admin/Pages/Sections"
                   asp-route-id="@Model.Id"
                   asp-route-invalidSectionIds="@invalidIdsCsv">
                    Fix in Sections
                </a>
            }
        </div>

        <ul class="mb-0">
            @foreach (var e in Model.PublishValidationErrors)
            {
                if (e.SectionId == 0)
                {
                    foreach (var msg in e.Messages)
                    {
                        <li>@msg</li>
                    }
                }
                else
                {
                    <li>
                        <a href="#section-@e.SectionId" class="text-decoration-underline">
                            Section #@e.SectionId (@e.TypeKey)
                        </a>

                        <ul class="mb-0">
                            @foreach (var msg in e.Messages)
                            {
                                <li>@msg</li>
                            }
                        </ul>
                    </li>
                }
            }
        </ul>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Banner))
{
    <div class="alert alert-info">@Model.Banner</div>
}

@* ✅ Two-column layout: Editor (left) + Live Preview (right) *@
<div class="row g-3">
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-body">
                @* ✅ Main Save form (single form only) *@
                <form id="pageEditForm" method="post" asp-page-handler="Save">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Title</label>
                            <input asp-for="Input.Title" class="form-control" />
                            <span asp-validation-for="Input.Title" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Slug</label>
                            <input asp-for="Input.Slug" class="form-control" />
                            <div class="form-text">Empty = home.</div>
                            <span asp-validation-for="Input.Slug" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Layout Key</label>
                            <input asp-for="Input.LayoutKey" class="form-control" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Show in Navigation</label>
                            <div class="form-check form-switch">
                                <input asp-for="Input.ShowInNavigation" class="form-check-input" />
                                <label class="form-check-label" asp-for="Input.ShowInNavigation">Enabled</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Meta Title</label>
                            <input asp-for="Input.MetaTitle" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Meta Description</label>
                            <textarea asp-for="Input.MetaDescription" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <hr class="my-4" />

                    @* ✅ Sections header *@
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-semibold">Sections</div>
                            <div class="text-muted small">
                                Draft sections: @Model.SectionCount
                                @if (!Model.HasDraft)
                                {
                                    <span class="ms-2 badge text-bg-warning">No Draft</span>
                                }
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    id="addSectionBtn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#addSectionModal"
                                    @(Model.HasDraft ? null : "disabled")>
                                Add Section
                            </button>

                            <a class="btn btn-outline-secondary"
                               asp-page="/Admin/Pages/Sections"
                               asp-route-id="@Model.Id">
                                Manage Sections / Revisions
                            </a>
                        </div>
                    </div>

                    <div id="sectionsHost" class="mt-3">
                        @if (!Model.HasDraft)
                        {
                            <div class="alert alert-warning mb-0">
                                No draft exists for this page. Restore a draft from a published revision to edit sections.
                            </div>
                        }
                        else if (Model.SectionCount == 0)
                        {
                            <div class="alert alert-light border mb-0" id="noSectionsAlert">
                                No sections yet. Use <strong>Add Section</strong> to add sections.
                            </div>
                        }
                        else
                        {
                            <div id="sectionsList" class="d-grid gap-2">
                                @foreach (var row in Model.SectionRows)
                                {
                                    <partial name="Partials/_PageRevisionSectionRow" model="row" />
                                }
                            </div>
                        }
                    </div>

                    <div class="mt-3 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">Save Draft</button>
                    </div>
                </form>
            </div>
        </div>

        @* Published info remains under editor column *@
        @if (Model.PublishedInfo is not null)
        {
            <div class="card mt-3">
                <div class="card-body">
                    <div class="fw-semibold">Published</div>
                    <div class="text-muted small">
                        Revision #@Model.PublishedInfo.VersionNumber · Slug: <code>@Model.PublishedInfo.Slug</code>
                        @if (Model.PublishedInfo.PublishedAt is not null)
                        {
                            <span>· @Model.PublishedInfo.PublishedAt</span>
                        }
                    </div>

                    @if (!Model.HasDraft)
                    {
                        <form method="post" asp-page-handler="RestoreDraft" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="revisionId" value="@Model.PublishedInfo.Id" />
                            <button class="btn btn-outline-primary" type="submit">Restore Draft From Published</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    @* ✅ Live Preview column *@
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div class="fw-semibold">Live Preview</div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="previewRefreshBtn">
                        Refresh
                    </button>
                    <span class="text-muted small" id="previewStatus"></span>
                </div>
            </div>

            <div class="card-body p-0" style="height: 75vh;">
                <iframe id="previewFrame"
                        title="Draft Preview"
                        style="border:0;width:100%;height:100%;"
                        src="@Url.Page("/Admin/Pages/Preview", new { id = Model.Id, rev = "draft" })">
                </iframe>
            </div>
        </div>
    </div>
</div>

@* ✅ Add Section Modal *@
<div class="modal fade" id="addSectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Section</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <label class="form-label">Section Type</label>
                <select class="form-select" id="addSectionType">
                    <option value="">-- Select --</option>
                    @foreach (var opt in Model.SectionTypeOptions)
                    {
                        <option value="@opt.Value">@opt.Text</option>
                    }
                </select>

                <div class="mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="insertAtTop">
                        <label class="form-check-label" for="insertAtTop">Insert at top</label>
                    </div>

                    <label class="form-label mt-2">Insert after (optional)</label>
                    <select class="form-select" id="insertAfter">
                        <option value="">(Bottom)</option>
                        @foreach (var row in Model.SectionRows)
                        {
                            <option value="@row.RevisionSectionId">@row.Title</option>
                        }
                    </select>

                    <div class="form-text">
                        If “Insert at top” is checked, “Insert after” is ignored.
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmAddSectionBtn">Add</button>
            </div>
        </div>
    </div>
</div>

@section PageBuilderScripts {
    <script src="~/js/pagebuilder/section-editor-base.js" asp-append-version="true"></script>
    <script src="~/js/pagebuilder/editors/hero-editor.js" asp-append-version="true"></script>
    <script src="~/js/pagebuilder/preview-controller.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.PageBuilder.initHeroEditors();
            window.PageBuilder.initPreview({ iframeId: "previewFrame" });
        });
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/pagebuilder/section-list-controller.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.PageBuilder.initSectionList({
                pageId: @Model.Id,
                draftRevisionRowVersionBase64: @Html.Raw(JsonSerializer.Serialize(Model.DraftRevisionRowVersionBase64 ?? "")),
                invalidSectionIds: @Html.Raw(JsonSerializer.Serialize(
                                    Model.PublishValidationErrors?
                                            .Where(e => e.SectionId > 0)
                                            .Select(e => e.SectionId)
                                            .Distinct()
                                            .ToList() ?? new List<int>()))
        });
    });
</script>
}
