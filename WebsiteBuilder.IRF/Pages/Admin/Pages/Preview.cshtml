@page "{id:int}"
@model WebsiteBuilder.IRF.Pages.Admin.Pages.PreviewModel
@{
    Layout = null; // iframe-friendly
    var ctx = Model.Ctx!;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Preview - @(ctx.PageEntity?.Title ?? "Page")</title>

    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            margin: 0;
        }

        .preview-wrap {
            padding: 24px;
        }
    </style>
</head>
<body>
    <div class="preview-wrap">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="fw-semibold">@ctx.PageEntity?.Title</div>
            <span class="badge text-bg-secondary">Draft Preview</span>
        </div>

        @foreach (var section in ctx.RenderSections)
        {
            <div class="mb-4">
                @await Component.InvokeAsync("PageSection", new
                {
                    sectionTypeId = section.SectionTypeId,
                        settingsJson = section.SettingsJson
                        })
        </div>
                }
    </div>

    <script>
        window.addEventListener("message", (e) => {
            if (!e?.data) return;
            if (e.data.type === "PAGEBUILDER_REFRESH") {
                e.source?.postMessage({ type: "PAGEBUILDER_REFRESH_ACK" }, "*");
                window.location.reload();
            }
        });
    </script>
</body>
</html>
