@page
@model WebsiteBuilder.IRF.Pages.Admin.Pages.CreateModel
@{
    ViewData["Title"] = "New Page";
}

<h2 class="mb-3">New Page</h2>

<form method="post" class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">Title</label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Slug</label>
                <input asp-for="Input.Slug" class="form-control" placeholder="about (leave empty for home)" />
                <div class="form-text">Use <code>about</code> or <code>services</code>. Empty = home.</div>
                <span asp-validation-for="Input.Slug" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Layout Key</label>
                <input asp-for="Input.LayoutKey" class="form-control" />
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Show in Navigation</label>
                <div class="form-check form-switch">
                    <input asp-for="Input.ShowInNavigation" class="form-check-input" />
                    <label class="form-check-label" asp-for="Input.ShowInNavigation">Enabled</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">Meta Title</label>
                <input asp-for="Input.MetaTitle" class="form-control" />
            </div>

            <div class="col-12">
                <label class="form-label">Meta Description</label>
                <textarea asp-for="Input.MetaDescription" class="form-control" rows="3"></textarea>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2 justify-content-end">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Pages/Index">Cancel</a>
        <button type="submit" class="btn btn-primary">Create Draft</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
