@model WebsiteBuilder.IRF.ViewModels.Admin.Pages.SectionRowRenderVm

@{
    // Rule for Admin/Pages/Edit: delete + reorder ON, edit OFF
    // Model.IsEditable means: can open the editor UI
    var canEdit = Model.IsEditable;

    var revisionSectionId = Model.RevisionSectionId;
    var sectionTypeId = Model.SectionTypeId;

    var collapseId = !string.IsNullOrWhiteSpace(Model.CollapseId)
        ? Model.CollapseId
        : $"sec-editor-{revisionSectionId}";

    // If your registry stores paths like "Shared/Sections/_Text", keep it.
    // If it stores absolute paths, those also work.
    var editorPath = !string.IsNullOrWhiteSpace(Model.EditorPartialPath)
        ? Model.EditorPartialPath
        : "Shared/Sections/_Unknown";

    var editorModel = Model.Section;

    // Optional: set to true if you want to display IDs in UI
    var showDebugIds = false;
}

<div class="card section-item"
     id="section-@revisionSectionId"
     data-revision-section-id="@revisionSectionId"
     data-section-type-id="@sectionTypeId">

    <div class="card-body py-2 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            @* ✅ Reorder ON *@
            <span class="me-2 cursor-grab section-drag-handle user-select-none"
                  role="button"
                  tabindex="0"
                  title="Drag to reorder"
                  aria-label="Drag to reorder">⠿</span>

            <div>
                <div class="fw-semibold section-title">@Model.Title</div>

                @if (showDebugIds)
                {
                    <div class="text-muted small">
                        Revision Section ID: @revisionSectionId • SectionTypeId: @sectionTypeId
                    </div>
                }
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            @* ✅ Delete ON *@
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    data-delete-revision-section="@revisionSectionId">
                Delete
            </button>

            @* Edit OFF on Edit page; ON only when Model.IsEditable *@
            @if (canEdit)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-bs-toggle="collapse"
                        data-bs-target="#@collapseId"
                        aria-expanded="false"
                        aria-controls="@collapseId">
                    Edit
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        disabled>
                    Edit
                </button>
            }
        </div>
    </div>

    @* Only render editor UI if allowed *@
    @if (canEdit)
    {
        <div id="@collapseId" class="collapse border-top">
            <div class="p-3">
                @if (editorModel is null)
                {
                    <div class="alert alert-warning mb-0">
                        Section model not loaded for this row. Please reload the page.
                    </div>
                }
                else
                {
                    <partial name="@editorPath" model="editorModel" />
                }
            </div>
        </div>
    }
</div>
