@model WebsiteBuilder.IRF.ViewModels.Admin.Pages.SectionRowRenderVm

@{
    // Prefer VM; fallback to ViewData
    var isEditable = Model.IsEditable || ((ViewData["IsEditable"] as bool?) ?? false);

    // ✅ PageRevisionSection row id (must use for edit/reorder/delete)
    var revisionSectionId = Model.RevisionSectionId;

    // ✅ robust: use VM value (do NOT depend on Model.Section being populated)
    var sectionTypeId = Model.SectionTypeId;

    // ✅ stable collapse id
    var collapseId = !string.IsNullOrWhiteSpace(Model.CollapseId)
        ? Model.CollapseId
        : $"sec-editor-{revisionSectionId}";

    var editorPath = Model.EditorPartialPath;
}

<div class="card section-item"
     id="section-@revisionSectionId"
     data-revision-section-id="@revisionSectionId"
     data-section-type-id="@sectionTypeId">

    <div class="card-body py-2 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            @if (isEditable)
            {
                <span class="me-2 cursor-grab" title="Drag to reorder" aria-label="Drag to reorder">⠿</span>
            }
            else
            {
                <span class="text-muted me-2" title="Reordering disabled">⠿</span>
            }

            <div>
                <div class="fw-semibold section-title">@Model.Title</div>
                <div class="text-muted small">
                    RevisionSectionId: @revisionSectionId • SectionTypeId: @sectionTypeId
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    data-delete-revision-section="@revisionSectionId"
                    @(isEditable ? null : "disabled")>
                Delete
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-bs-toggle="collapse"
                    data-bs-target="#@collapseId"
                    aria-expanded="false"
                    aria-controls="@collapseId"
                    @(isEditable ? null : "disabled")>
                Edit
            </button>
        </div>
    </div>

    <div id="@collapseId" class="collapse border-top">
        <div class="p-3">
            @* Your editor partials expect PageRevisionSection *@
            <partial name="@editorPath" model="Model.Section" />
        </div>
    </div>
</div>
